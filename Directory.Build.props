<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CA1707: underscores are used in test names; CA1848/CA1873: LoggerMessage delegates are overkill for this codebase;
         CA1062: nullable reference types already cover argument null checks; CA2007: no ConfigureAwait in ASP.NET Core;
         CA1711/CA1716/CA1720: domain naming (e.g. "Ended", "Session"); CA1861: constant arrays in tests/config;
         CA1515/CA1724: public types are required for minimal-API/handler discovery; CA2227/CA1002: EF-friendly collections. -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA1062;CA2007;CA1711;CA1716;CA1720;CA1861;CA1515;CA1724;CA2227;CA1002;CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1862;CA1056;CA1054;CA1819;CA1034;CA1000;CA2201;CA1812</NoWarn>
  </PropertyGroup>
</Project>
