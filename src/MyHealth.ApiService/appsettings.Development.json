{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "RequireConfirmedEmail": false
  },
  "Database": {
    "InitializeOnStartup": true
  },
  "Security": {
    "RequireTwoFactorForProfessionals": false
  },
  "Media": {
    "PublicBaseUrl": "https://localhost:7335/media",
    "AllowedHosts": [ "media.myhealth.app", "localhost" ]
  }
}
