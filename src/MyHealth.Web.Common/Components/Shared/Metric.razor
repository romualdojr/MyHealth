<div class="@($"{Ui.Card} h-full {(Warn && Value > 0 ? "border-amber-300 bg-amber-50" : string.Empty)}")">
    <div class="p-3 sm:p-5">
        <div class="text-xs leading-snug text-slate-500 sm:text-sm">@Label</div>
        <div class="mt-1 text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl">@(Text ?? Value.ToString(System.Globalization.CultureInfo.CurrentCulture))</div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int Value { get; set; }

    /// <summary>Shown instead of <see cref="Value"/> (amounts, for example).</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Highlights the card when the value is above zero.</summary>
    [Parameter]
    public bool Warn { get; set; }
}
