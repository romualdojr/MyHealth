@* Shows an API problem (RFC 9457) in plain words. *@
@if (Problem is not null)
{
    <div class="@($"{Ui.AlertDanger} mb-4")" role="alert">
        @Problem.Message
        <small class="mt-1 block text-xs text-red-600/80">@Problem.Code</small>
    </div>
}

@code {
    [Parameter]
    public ApiProblem? Problem { get; set; }
}
