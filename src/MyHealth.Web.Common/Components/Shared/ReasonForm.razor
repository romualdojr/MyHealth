@* An inline confirmation with a free-text justification, used for actions that are audited with a reason. *@

<div class="@($"{(Tone == "danger" ? Ui.CardDanger : Ui.CardHighlight)} mb-4")">
    <div class="@Ui.CardBody">
        <h2 class="@Ui.CardTitle">@Title</h2>
        @if (Description is not null)
        {
            <p class="@($"{Ui.Help} mt-1")">@Description</p>
        }
        <label class="@($"{Ui.Label} mt-3")" for="reason-text">@Label</label>
        <textarea id="reason-text" class="@($"{Ui.Textarea} mb-3")" rows="2" @bind="_text" @bind:event="oninput"></textarea>
        <div class="flex gap-2">
            <button class="@(Tone switch { "danger" => Ui.ButtonDangerSm, "success" => Ui.ButtonSuccessSm, _ => Ui.ButtonSm })" disabled="@(Required && string.IsNullOrWhiteSpace(_text))" @onclick="() => OnConfirm.InvokeAsync(_text)">@ConfirmText</button>
            <button class="@Ui.ButtonLinkSm" @onclick="OnCancel">Cancelar</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Label { get; set; } = "Motivo";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirmar";

    [Parameter]
    public bool Required { get; set; } = true;

    /// <summary>Tone of the confirmation: <c>primary</c>, <c>success</c> or <c>danger</c>.</summary>
    [Parameter]
    public string Tone { get; set; } = "primary";

    [Parameter]
    public EventCallback<string?> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string? _text;
}
