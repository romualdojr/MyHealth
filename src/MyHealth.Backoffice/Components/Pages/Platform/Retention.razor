@page "/admin/retention"
@attribute [Authorize(Roles = SessionClaims.AdministratorRole)]
@inject MyHealthApiClient Api

<PageTitle>Retenção · Plataforma</PageTitle>

<h1 class="@Ui.PageTitle">Políticas de retenção</h1>
<p class="@($"{Ui.Help} mb-4")">
    Prazo e base legal por tipo de registro (RF-50, RNF-01). Os valores devem vir da assessoria jurídica; por enquanto são registrados e
    publicados, ainda sem expurgo automático.
</p>

<ProblemAlert Problem="_problem" />

@if (_items is null)
{
    <Loading />
}
else
{
    <div class="@Ui.TableWrap">
        <table class="@Ui.Table">
            <thead class="@Ui.THead">
                <tr><th class="@Ui.Th">Registro</th><th class="@($"{Ui.Th} w-36")">Meses</th><th class="@Ui.Th">Base legal</th><th class="@Ui.Th">Observações</th><th class="@Ui.Th"></th></tr>
            </thead>
            <tbody class="@Ui.TBody">
                @foreach (var row in _items)
                {
                    <tr>
                        <td class="@Ui.Td">
                            <code class="rounded bg-slate-100 px-1 font-mono text-xs">@row.RecordType</code>
                            @if (row.UpdatedAt is { } at)
                            {
                                <div class="text-xs text-slate-500">@at.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            }
                        </td>
                        <td class="@Ui.Td"><input type="number" min="1" max="1200" class="@Ui.InputSm" @bind="row.Months" aria-label="Meses" /></td>
                        <td class="@Ui.Td"><input class="@($"{Ui.InputSm} min-w-40")" @bind="row.LegalBasis" aria-label="Base legal" /></td>
                        <td class="@Ui.Td"><input class="@($"{Ui.InputSm} min-w-40")" @bind="row.Notes" aria-label="Observações" /></td>
                        <td class="@Ui.Td">
                            <button class="@Ui.ButtonOutlineSm" disabled="@(row.Months is null || string.IsNullOrWhiteSpace(row.LegalBasis))"
                                    @onclick="() => SaveAsync(row)">Salvar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed class Row
    {
        public string RecordType { get; init; } = string.Empty;

        public int? Months { get; set; }

        public string? LegalBasis { get; set; }

        public string? Notes { get; set; }

        public DateTimeOffset? UpdatedAt { get; set; }
    }

    private List<Row>? _items;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<RetentionPolicyItem>>("admin/retention-policies");
        _problem = result.Problem;
        _items = (result.Value ?? [])
            .Select(p => new Row { RecordType = p.RecordType, Months = p.RetentionMonths, LegalBasis = p.LegalBasis, Notes = p.Notes, UpdatedAt = p.UpdatedAt })
            .ToList();
    }

    private async Task SaveAsync(Row row)
    {
        var result = await Api.PutAsync($"admin/retention-policies/{row.RecordType}", new { retentionMonths = row.Months, legalBasis = row.LegalBasis, notes = row.Notes });
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            row.UpdatedAt = DateTimeOffset.Now;
        }
    }
}
