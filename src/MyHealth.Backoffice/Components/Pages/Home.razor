@page "/"
@attribute [Authorize(Roles = SessionClaims.AdministratorRole)]
@inject MyHealthApiClient Api

<PageTitle>Visão geral · Back office</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 m-0">Cobrança</h1>
    <button class="btn btn-outline-primary btn-sm" disabled="@_running" @onclick="RunCycleAsync">Executar ciclo de cobrança agora</button>
</div>
<p class="text-body-secondary">
    Organizações e consultórios individuais pagam a MyHealth por módulo, mensalmente e de forma antecipada. O ciclo roda sozinho uma vez por dia:
    emite as faturas do período, marca em atraso após o vencimento e suspende depois da carência.
</p>

<ProblemAlert Problem="_problem" />

@if (_cycle is { } cycle)
{
    <div class="alert alert-info">
        Ciclo executado: @cycle.Subscriptions assinaturas, @cycle.InvoicesIssued faturas emitidas, @cycle.PastDue em atraso, @cycle.Suspended suspensas.
        @if (cycle.Skipped.Count > 0)
        {
            <span class="d-block small">Ignoradas: @string.Join("; ", cycle.Skipped)</span>
        }
    </div>
}

@if (_summary is null)
{
    <Loading />
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><Metric Label="Receita recorrente mensal" Text="@BillingLabels.Money(_summary.MonthlyRecurringRevenueCents)" /></div>
        <div class="col-6 col-lg-3"><Metric Label="Recebido nos últimos 30 dias" Text="@BillingLabels.Money(_summary.PaidLast30DaysCents)" /></div>
        <div class="col-6 col-lg-3"><Metric Label="Em aberto" Text="@BillingLabels.Money(_summary.OpenAmountCents)" /></div>
        <div class="col-6 col-lg-3">
            <Metric Label="Vencido" Text="@BillingLabels.Money(_summary.OverdueAmountCents)" Value="@(_summary.OverdueAmountCents > 0 ? 1 : 0)" Warn="true" />
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <h2 class="h5">Assinaturas por situação</h2>
            <ul class="list-group">
                @foreach (var status in BillingLabels.Statuses)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a href="billing/tenants?status=@status"><StatusBadge Status="@status" /></a>
                        <span class="fw-semibold">@_summary.TenantsByStatus.GetValueOrDefault(status)</span>
                    </li>
                }
            </ul>
        </div>
        <div class="col-lg-8">
            <h2 class="h5">Pagamentos recentes</h2>
            @if (_summary.RecentPayments.Count == 0)
            {
                <p class="text-body-secondary">Nenhum pagamento ainda.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Organização</th><th>Valor</th><th>Pago em</th><th>Referência</th></tr></thead>
                    <tbody>
                        @foreach (var p in _summary.RecentPayments)
                        {
                            <tr>
                                <td><a href="billing/tenants/@p.TenantId">@p.TenantName</a></td>
                                <td>@BillingLabels.Money(p.AmountCents)</td>
                                <td>@BillingLabels.Date(p.PaidAt)</td>
                                <td class="small text-body-secondary">@p.Reference</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private RevenueSummary? _summary;
    private BillingCycleResult? _cycle;
    private ApiProblem? _problem;
    private bool _running;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<RevenueSummary>("admin/billing/summary");
        _summary = result.Value;
        _problem = result.Problem;
    }

    private async Task RunCycleAsync()
    {
        _running = true;
        var result = await Api.PostAsync<BillingCycleResult>("admin/billing/run-cycle", null);
        _cycle = result.Value;
        _problem = result.Problem;
        _running = false;
        await LoadAsync();
    }
}
