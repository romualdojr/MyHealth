@page "/billing/tenants"
@attribute [Authorize(Roles = SessionClaims.AdministratorRole)]
@inject MyHealthApiClient Api
@inject NavigationManager Navigation

<PageTitle>Assinaturas · Back office</PageTitle>

<h1 class="@Ui.PageTitle">Assinaturas</h1>
<p class="@($"{Ui.Help} mb-4")">Quem paga a MyHealth: cada organização ou consultório individual, seus módulos e a situação dos pagamentos.</p>

<div class="mb-4 flex flex-wrap gap-2">
    <button class="@(Status is null ? Ui.ButtonSm : Ui.ButtonSecondarySm)" @onclick="() => Filter(null)">Todas</button>
    @foreach (var status in BillingLabels.Statuses)
    {
        <button class="@(Status == status ? Ui.ButtonSm : Ui.ButtonSecondarySm)" @onclick="() => Filter(status)">@Labels.Status(status)</button>
    }
</div>

<ProblemAlert Problem="_problem" />

@if (_items is null)
{
    <Loading />
}
else if (_items.Count == 0)
{
    <p class="@Ui.Help">Nenhuma assinatura nesta situação.</p>
}
else
{
    <div class="@Ui.TableWrap">
        <table class="@Ui.Table">
            <thead class="@Ui.THead">
                <tr><th class="@Ui.Th">Organização</th><th class="@Ui.Th">Situação</th><th class="@Ui.Th">Módulos</th><th class="@($"{Ui.Th} text-right")">Mensalidade</th><th class="@($"{Ui.Th} text-right")">Em aberto</th><th class="@($"{Ui.Th} text-right")">Vencido</th><th class="@Ui.Th">Próxima fatura</th><th class="@Ui.Th">Último pagamento</th></tr>
            </thead>
            <tbody class="@Ui.TBody">
                @foreach (var t in _items)
                {
                    <tr>
                        <td class="@Ui.Td">
                            <a class="@Ui.Link" href="billing/tenants/@t.TenantId">@t.Name</a>
                            <span class="block text-xs text-slate-500">@BillingLabels.Kind(t.Kind)</span>
                        </td>
                        <td class="@Ui.Td"><StatusBadge Status="@t.Status" /></td>
                        <td class="@($"{Ui.Td} text-xs")">@string.Join(", ", t.Modules.Select(BillingLabels.Module))</td>
                        <td class="@($"{Ui.Td} text-right")">@BillingLabels.Money(t.MonthlyAmountCents)</td>
                        <td class="@($"{Ui.Td} text-right")">@BillingLabels.Money(t.OpenAmountCents)</td>
                        <td class="@($"{Ui.Td} text-right {(t.OverdueAmountCents > 0 ? "font-semibold text-red-700" : string.Empty)}")">@BillingLabels.Money(t.OverdueAmountCents)</td>
                        <td class="@Ui.Td">@(t.Status == "Trial" ? $"fim do teste {BillingLabels.Date(t.TrialEndsAt)}" : BillingLabels.Date(t.NextInvoiceAt))</td>
                        <td class="@Ui.Td">@(t.LastPaidAt is { } paid ? BillingLabels.Date(paid) : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private string? Status { get; set; }

    private List<TenantBillingItem>? _items;
    private ApiProblem? _problem;

    protected override async Task OnParametersSetAsync()
    {
        _items = null;
        var result = await Api.GetAsync<List<TenantBillingItem>>(Status is null ? "admin/billing/tenants" : $"admin/billing/tenants?status={Uri.EscapeDataString(Status)}");
        _items = result.Value ?? [];
        _problem = result.Problem;
    }

    private void Filter(string? status) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("status", status));
}
