@page "/billing/prices"
@attribute [Authorize(Roles = SessionClaims.AdministratorRole)]
@inject MyHealthApiClient Api

<PageTitle>Preços dos módulos · Back office</PageTitle>

<h1 class="@Ui.PageTitle">Preços dos módulos</h1>
<p class="@($"{Ui.Help} mb-4")">
    Valor mensal de cada módulo. Uma organização paga a soma dos módulos que contratou. Um novo preço vale a partir da data escolhida, nas faturas
    emitidas depois dela; faturas já emitidas mantêm o valor original.
</p>

<ProblemAlert Problem="_problem" />

@if (_message is not null)
{
    <div class="@($"{Ui.AlertSuccess} mb-4")">@_message</div>
}

@if (_items is null)
{
    <Loading />
}
else
{
    <div class="@Ui.TableWrap">
        <table class="@Ui.Table">
            <thead class="@Ui.THead"><tr><th class="@Ui.Th">Módulo</th><th class="@($"{Ui.Th} text-right")">Preço atual</th><th class="@Ui.Th">Desde</th><th class="@Ui.Th">Agendado</th><th class="@($"{Ui.Th} w-[26rem]")">Novo preço</th></tr></thead>
            <tbody class="@Ui.TBody">
                @foreach (var p in _items)
                {
                    var scheduled = p.History.Where(h => h.EffectiveFrom > DateTimeOffset.UtcNow).OrderBy(h => h.EffectiveFrom).ToList();
                    <tr>
                        <td class="@($"{Ui.Td} font-semibold text-slate-900")">@BillingLabels.Module(p.Module)</td>
                        <td class="@($"{Ui.Td} text-right")">@(p.MonthlyAmountCents is { } cents ? BillingLabels.Money(cents) : "sem preço")</td>
                        <td class="@Ui.Td">@(p.EffectiveFrom is { } from ? BillingLabels.Date(from) : "—")</td>
                        <td class="@($"{Ui.Td} text-xs")">@string.Join("; ", scheduled.Select(h => $"{BillingLabels.Money(h.MonthlyAmountCents)} em {BillingLabels.Date(h.EffectiveFrom)}"))</td>
                        <td class="@Ui.Td">
                            <div class="flex items-stretch gap-1">
                                <span class="@($"{Ui.InputAddon} rounded-md")">R$</span>
                                <input type="number" min="0" step="0.01" class="@($"{Ui.InputSm} min-w-0 flex-1")" placeholder="0,00" @bind="_drafts[p.Module].Amount" />
                                <input type="date" class="@($"{Ui.InputSm} min-w-0 flex-1")" title="Vale a partir de (vazio: agora)" @bind="_drafts[p.Module].From" />
                                <button class="@Ui.ButtonSm" disabled="@(_drafts[p.Module].Amount is null)" @onclick="() => SaveAsync(p.Module)">Salvar</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private sealed class Draft
    {
        public decimal? Amount { get; set; }

        public DateTime? From { get; set; }
    }

    private List<ModulePriceItem>? _items;
    private Dictionary<string, Draft> _drafts = [];
    private ApiProblem? _problem;
    private string? _message;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<ModulePriceItem>>("admin/billing/module-prices");
        _items = result.Value ?? [];
        _drafts = _items.ToDictionary(p => p.Module, _ => new Draft());
        _problem = result.Problem;
    }

    private async Task SaveAsync(string module)
    {
        var draft = _drafts[module];
        DateTimeOffset? effectiveFrom = draft.From is { } from && from.Date > DateTime.Today ? new DateTimeOffset(from.Date) : null;
        var result = await Api.PutAsync($"admin/billing/module-prices/{module}", new
        {
            monthlyAmountCents = (long)Math.Round(draft.Amount!.Value * 100m, MidpointRounding.AwayFromZero), effectiveFrom,
        });

        _problem = result.Problem;
        if (result.IsSuccess)
        {
            _message = $"Preço de {BillingLabels.Module(module)} atualizado.";
            await LoadAsync();
        }
    }
}
