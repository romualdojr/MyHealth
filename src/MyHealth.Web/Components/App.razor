<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/MyHealth.Web.Common/lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MyHealth.Web.Common/app.css"]" />
    <link rel="stylesheet" href="@Assets["MyHealth.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/media.js"]"></script>
    @* 3D exercise models (glTF) in the library: Google's model-viewer web component. *@
    <script type="module" src="https://cdn.jsdelivr.net/npm/@@google/model-viewer@@3.5.0/dist/model-viewer.min.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    // Every page is interactive except those that must set the auth cookie (sign-in), which render statically.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? AppRenderModes.Interactive : null;
}
