<!DOCTYPE html>
<html lang="pt-BR" class="h-full">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    @* Installable app (PWA) and the iPhone home screen. *@
    <meta name="theme-color" content="#0f766e" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MyHealth" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <base href="/" />
    @* Tailwind CSS, built from MyHealth.Web.Common/Styles/tailwind.css: the only stylesheet. *@
    <link rel="stylesheet" href="@Assets["_content/MyHealth.Web.Common/css/app.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="min-h-full bg-slate-50 text-slate-900 antialiased">
    <Routes @rendermode="PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/media.js"]"></script>
    @* 3D exercise models (glTF) in the library: Google's model-viewer web component. *@
    <script type="module" src="https://cdn.jsdelivr.net/npm/@@google/model-viewer@@3.5.0/dist/model-viewer.min.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    // Every page is interactive except those that must set the auth cookie (sign-in), which render statically.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? AppRenderModes.Interactive : null;
}
