@inherits LayoutComponentBase
@implements IDisposable
@inject WorkspaceState Workspace

<AppShell Brand="MyHealth">
    <Navigation>
        <NavMenu />
    </Navigation>
    <TopBar>
        <AuthorizeView>
            <Authorized>
                <TenantSwitcher />
                <span class="hidden text-sm text-slate-500 sm:inline">@context.User.Identity?.Name</span>
                <form action="account/logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="@Ui.ButtonSecondarySm">Sair</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </TopBar>
    <ChildContent>
        <AuthorizeView>
            <Authorized>
                @if (_loaded)
                {
                    <BillingBanner />
                    @Body
                }
                else
                {
                    <Loading />
                }
            </Authorized>
            <NotAuthorized>
                @Body
            </NotAuthorized>
        </AuthorizeView>
    </ChildContent>
</AppShell>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        if ((await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            await Workspace.EnsureLoadedAsync();
        }

        _loaded = true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
