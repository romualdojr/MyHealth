@inherits LayoutComponentBase
@implements IDisposable
@inject WorkspaceState Workspace

<AppShell Brand="MyHealth">
    <Navigation>
        <NavMenu />
    </Navigation>
    <TopBar>
        <AuthorizeView>
            <Authorized>
                <TenantSwitcher />
                <span class="truncate text-sm text-slate-500">@context.User.Identity?.Name</span>
                <form action="account/logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="@($"{Ui.ButtonSecondarySm} w-full lg:w-auto")">Sair</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </TopBar>
    <TabBar>
        <AuthorizeView>
            <Authorized>
                <NavLink class="@Ui.TabLink" href="" Match="NavLinkMatch.All">@Icon(Home)<span>Início</span></NavLink>
                @if (Workspace.Practices("PersonalTrainer"))
                {
                    <NavLink class="@Ui.TabLink" href="trainer">@Icon(People)<span>Clientes</span></NavLink>
                    <NavLink class="@Ui.TabLink" href="trainer/assistant">@Icon(Sparkles)<span>Assistente</span></NavLink>
                    <NavLink class="@Ui.TabLink" href="trainer/exercises">@Icon(Book)<span>Biblioteca</span></NavLink>
                }
                else if (Workspace.IsTenantAdministrator)
                {
                    <NavLink class="@Ui.TabLink" href="organization/members">@Icon(People)<span>Membros</span></NavLink>
                    <NavLink class="@Ui.TabLink" href="organization/billing">@Icon(Card)<span>Plano</span></NavLink>
                }
                <label for="nav-toggle" class="@($"{Ui.TabLink} cursor-pointer")">@Icon(Menu)<span>Mais</span></label>
            </Authorized>
        </AuthorizeView>
    </TabBar>
    <ChildContent>
        <AuthorizeView>
            <Authorized>
                @if (_loaded)
                {
                    <BillingBanner />
                    @Body
                }
                else
                {
                    <Loading />
                }
            </Authorized>
            <NotAuthorized>
                @Body
            </NotAuthorized>
        </AuthorizeView>
    </ChildContent>
</AppShell>

@code {
    // Outline icons (24×24, stroke), drawn inline so no icon library is needed.
    private const string Home = "M3 10.5 12 3l9 7.5M5 9.5V20a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V9.5";
    private const string People = "M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M9 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm13 9v-1a4 4 0 0 0-3-3.87M16 3.13a3.5 3.5 0 0 1 0 6.75";
    private const string Sparkles = "M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3Zm6.5 11 .9 2.1 2.1.9-2.1.9-.9 2.1-.9-2.1-2.1-.9 2.1-.9.9-2.1Z";
    private const string Book = "M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Zm0 15A2.5 2.5 0 0 0 6.5 23H20v-5";
    private const string Card = "M3 6.5A1.5 1.5 0 0 1 4.5 5h15A1.5 1.5 0 0 1 21 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11ZM3 10h18";
    private const string Menu = "M4 6h16M4 12h16M4 18h16";

    private static RenderFragment Icon(string path) => __builder =>
    {
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="@path" />
        </svg>
    };

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        if ((await AuthenticationState).User.Identity?.IsAuthenticated == true)
        {
            await Workspace.EnsureLoadedAsync();
        }

        _loaded = true;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
