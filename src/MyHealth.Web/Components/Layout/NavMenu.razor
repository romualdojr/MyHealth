@implements IDisposable
@inject WorkspaceState Workspace

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MyHealth</a>
    </div>
</div>

<input type="checkbox" title="Menu de navegação" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Início</NavLink>
        </div>

        <AuthorizeView>
            @if (Workspace.Practices("PersonalTrainer"))
            {
                <div class="nav-section px-3">Treino</div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="trainer">Painel do treinador</NavLink></div>
            }

            @if (Workspace.IsTenantAdministrator)
            {
                <div class="nav-section px-3">Organização</div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="organization/members">Membros</NavLink></div>
                <div class="nav-item px-3"><NavLink class="nav-link" href="organization/audit">Auditoria</NavLink></div>
            }
        </AuthorizeView>

        <AuthorizeView Roles="@SessionClaims.AdministratorRole">
            <div class="nav-section px-3">Plataforma</div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/professionals">Profissionais</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/qualifications">Qualificações</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/modalities">Terapias</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/privacy-requests">Solicitações LGPD</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/retention">Retenção</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/audit">Auditoria</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/tenants">Organizações</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/operators">Operadores</NavLink></div>
        </AuthorizeView>

        <AuthorizeView>
            <div class="nav-section px-3">Conta</div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="account/security">Segurança</NavLink></div>
        </AuthorizeView>
    </nav>
</div>

@code {
    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
