@implements IDisposable
@inject WorkspaceState Workspace

<NavLink class="@Ui.NavLink" href="" Match="NavLinkMatch.All">Início</NavLink>

<AuthorizeView>
    @if (Workspace.Practices("PersonalTrainer"))
    {
        <div class="@Ui.NavSection">Treino</div>
        <NavLink class="@Ui.NavLink" href="trainer" Match="NavLinkMatch.All">Clientes</NavLink>
        <NavLink class="@Ui.NavLink" href="trainer/assistant">Assistente IA</NavLink>
        <NavLink class="@Ui.NavLink" href="trainer/exercises">Biblioteca de exercícios</NavLink>
    }

    @if (Workspace.Practices("Dietitian"))
    {
        <div class="@Ui.NavSection">Nutrição</div>
        <NavLink class="@Ui.NavLink" href="dietitian" Match="NavLinkMatch.All">Pacientes</NavLink>
    }

    @if (Workspace.IsTenantAdministrator)
    {
        <div class="@Ui.NavSection">Organização</div>
        <NavLink class="@Ui.NavLink" href="organization/members">Membros</NavLink>
        <NavLink class="@Ui.NavLink" href="organization/audit">Auditoria</NavLink>
        <NavLink class="@Ui.NavLink" href="organization/billing">Plano e cobrança</NavLink>
    }
</AuthorizeView>

<AuthorizeView>
    <div class="@Ui.NavSection">Conta</div>
    <NavLink class="@Ui.NavLink" href="account/security">Segurança</NavLink>
</AuthorizeView>

@code {
    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
