@page "/dietitian/plans/{PlanId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(_plan?.Details.Name ?? "Plano alimentar") · MyHealth</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigation" ConfirmExternalNavigation="@IsDirty" />

@if (!Workspace.Practices("Dietitian"))
{
    <p class="@Ui.AlertInfo">Selecione uma organização em que você atua como nutricionista.</p>
}
else if (_plan is null)
{
    <ProblemAlert Problem="_problem" />
    @if (_problem is null)
    {
        <Loading />
    }
}
else
{
    <nav aria-label="Caminho" class="@Ui.Breadcrumb">
        <a href="dietitian" class="@Ui.TapLink">Pacientes</a> / <a href="dietitian/clients/@_plan.ClientId" class="@Ui.TapLink">@(_clientName ?? "Paciente")</a> / @_plan.Details.Name
    </nav>

    @* Same header as the training plan editor: sticky from sm up; on phones only the action buttons stick. *@
    <div class="contents sm:sticky sm:top-[calc(3.5rem+env(safe-area-inset-top))] sm:z-20 sm:-mx-6 sm:mb-4 sm:flex sm:flex-wrap sm:items-center sm:gap-2 sm:border-b sm:border-slate-200 sm:bg-slate-50/95 sm:px-6 sm:py-3 sm:backdrop-blur lg:-mx-8 lg:px-8">
        <div class="mb-3 min-w-0 grow sm:mb-0">
            <h1 class="@($"{Ui.PageTitle} flex flex-wrap items-center gap-2 break-words")">
                @_plan.Details.Name
                <span class="@TrainingLabels.PlanBadge(_plan.Status)">@TrainingLabels.PlanStatus(_plan.Status)</span>
            </h1>
            <div class="text-sm text-slate-500">
                @(_plan.CurrentVersionNumber > 0 ? $"O paciente vê a versão {_plan.CurrentVersionNumber}." : "O paciente ainda não vê este plano.")
                @if (IsDirty)
                {
                    <strong class="font-semibold text-amber-700"> Alterações não salvas.</strong>
                }
                else if (_plan.HasUnpublishedChanges)
                {
                    <span> Rascunho salvo com alterações ainda não publicadas.</span>
                }
            </div>
        </div>
        @if (!IsEnded)
        {
            <div class="sticky top-[calc(3.5rem+env(safe-area-inset-top))] z-20 -mx-4 mb-4 grid grid-cols-2 gap-2 border-b border-slate-200 bg-slate-50/95 px-4 py-2 backdrop-blur sm:static sm:z-auto sm:mx-0 sm:mb-0 sm:flex sm:border-0 sm:bg-transparent sm:p-0 sm:backdrop-blur-none">
                <button class="@(IsDirty ? Ui.ButtonOutline : Ui.ButtonSecondary)" disabled="@(!IsDirty || _busy)" @onclick="SaveAsync">Salvar rascunho</button>
                <button class="@Ui.Button" disabled="@(_busy || !(IsDirty || _plan.HasUnpublishedChanges || _plan.CurrentVersionNumber == 0))"
                        @onclick="StartPublishing">Publicar…</button>
            </div>
        }
    </div>

    <ProblemAlert Problem="_problem" />

    @if (_issues is { Count: > 0 })
    {
        <div class="@($"{Ui.AlertWarning} mb-4")" role="alert">
            <p class="mb-1 font-medium">Antes de salvar, ajuste:</p>
            <ul class="list-disc space-y-0.5 pl-5">
                @foreach (var issue in _issues)
                {
                    <li>@issue</li>
                }
            </ul>
        </div>
    }

    @if (_message is not null)
    {
        <p class="@($"{Ui.AlertSuccess} mb-4")" role="status">@_message</p>
    }

    @if (_pendingNavigation is not null)
    {
        <div class="@($"{Ui.AlertWarning} mb-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center")" role="alert">
            <span class="grow">Há alterações não salvas neste plano.</span>
            <button class="@Ui.ButtonSm" @onclick="SaveAndLeaveAsync">Salvar e sair</button>
            <button class="@Ui.ButtonDangerOutlineSm" @onclick="DiscardAndLeave">Descartar alterações</button>
            <button class="@Ui.ButtonLinkSm" @onclick="() => _pendingNavigation = null">Continuar editando</button>
        </div>
    }

    @if (_publishing)
    {
        var issues = _draft.PublishingIssues();
        <div class="@($"{Ui.CardHighlight} mb-4")">
            <div class="@Ui.CardBody">
                <h2 class="@($"{Ui.CardTitle} mb-2")">Publicar versão @(_plan.CurrentVersionNumber + 1)</h2>
                @if (issues.Count > 0)
                {
                    <p class="mb-1 text-sm text-slate-700">Antes de publicar, ajuste:</p>
                    <ul class="mb-4 list-disc space-y-0.5 pl-5 text-sm text-red-700">
                        @foreach (var issue in issues)
                        {
                            <li>@issue</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="@($"{Ui.Help} mb-4")">
                        O paciente passa a seguir esta versão no aplicativo e recebe um aviso. As versões anteriores ficam no histórico.
                    </p>
                }
                <label class="@Ui.Label" for="change-description">O que mudou (o paciente vê este texto)</label>
                <input id="change-description" class="@($"{Ui.Input} mb-3")" @bind="_changeDescription" @bind:event="oninput" />
                <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
                    <button class="@Ui.Button" disabled="@(issues.Count > 0 || string.IsNullOrWhiteSpace(_changeDescription) || _busy)" @onclick="PublishAsync">Publicar agora</button>
                    <button class="@Ui.ButtonLink" @onclick="() => _publishing = false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    <datalist id="portion-units">
        @foreach (var unit in NutritionLabels.PortionUnits)
        {
            <option value="@unit"></option>
        }
    </datalist>

    <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 min-w-0 lg:col-span-9">
            <details class="@($"{Ui.Card} mb-4")" open="@(_detailsOpen == true)">
                <summary class="cursor-pointer px-3 py-3 font-medium text-slate-900 sm:px-4">
                    Dados do plano
                    <span class="text-sm font-normal break-words text-slate-500">— a partir de @_details.StartDate.ToString("dd/MM/yyyy")@(string.IsNullOrWhiteSpace(_details.Goal) ? string.Empty : $" · {_details.Goal}")</span>
                </summary>
                <div class="border-t border-slate-200 p-3 sm:p-5">
                    <fieldset class="min-w-0" disabled="@IsEnded">
                        <MealPlanDetailsEditor Form="_details" ShowNotes="true" Prefix="details" OnChanged="StateHasChanged" />
                    </fieldset>
                </div>
            </details>

            @if (_draft.Meals.Count == 0 && !IsEnded)
            {
                <div class="@($"{Ui.EmptyState} mb-4")">
                    <p class="mb-4">Monte as refeições do dia. Comece pelo dia padrão (café da manhã, lanches, almoço e jantar) ou uma refeição por vez.</p>
                    <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:justify-center">
                        <button class="@Ui.Button" @onclick="AddUsualDay">Usar o dia padrão (5 refeições)</button>
                        <button class="@Ui.ButtonOutline" @onclick="AddMeal">+ Uma refeição</button>
                    </div>
                </div>
            }

            <fieldset class="min-w-0" disabled="@IsEnded">
                @foreach (var meal in _draft.Meals)
                {
                    var index = _draft.Meals.IndexOf(meal);
                    <section class="@($"{Ui.Card} mb-4")" aria-label="@(string.IsNullOrWhiteSpace(meal.Name) ? $"Refeição {index + 1}" : meal.Name)">
                        <div class="grid grid-cols-[minmax(0,1fr)_7.5rem] items-end gap-2 rounded-t-xl border-b border-slate-200 bg-slate-50 px-3 py-3 sm:flex sm:flex-wrap sm:items-center sm:px-4">
                            <div class="min-w-0 sm:max-w-xs sm:grow">
                                <label class="sr-only" for="meal-name-@index">Nome da refeição</label>
                                <input id="meal-name-@index" class="@($"{Ui.InputSm} font-semibold")" @bind="meal.Name" @bind:event="oninput" />
                            </div>
                            <div class="min-w-0 sm:w-32">
                                <label class="sr-only" for="meal-time-@index">Horário de @meal.Name</label>
                                <input id="meal-time-@index" type="time" class="@($"{Ui.InputSm} min-w-0")" @bind="meal.Time" />
                            </div>
                            <span class="hidden grow sm:block"></span>
                            <div class="col-span-2 grid grid-cols-2 gap-2 sm:flex">
                                <button class="@Ui.ButtonSecondarySm" @onclick="() => DuplicateMeal(meal)">Duplicar</button>
                                <button class="@Ui.ButtonDangerOutlineSm" @onclick="() => RemoveMeal(meal)">Remover refeição</button>
                            </div>
                        </div>
                        <div class="p-3 sm:p-5">
                            @if (meal.Items.Count == 0)
                            {
                                <p class="@($"{Ui.Help} mb-3")">Nenhum alimento ainda.</p>
                            }
                            else
                            {
                                @* One row per food. On phones: the food and remove on the first line, quantity, unit and household
                                   measure on the second. From md up: a single row under column headings. *@
                                <div role="list" aria-label="Alimentos de @meal.Name" class="mb-1 text-sm">
                                    <div class="hidden gap-2 px-0.5 pb-1 text-xs font-semibold text-slate-500 md:grid md:grid-cols-[minmax(0,1fr)_5.5rem_8rem_minmax(0,0.8fr)_2rem]" aria-hidden="true">
                                        <span>Alimento</span><span>Quantidade</span><span>Unidade</span><span>Medida caseira</span><span></span>
                                    </div>
                                    <div class="divide-y divide-slate-100">
                                        @foreach (var item in meal.Items)
                                        {
                                            var position = meal.Items.IndexOf(item);
                                            var key = $"{index}-{position}";
                                            <div role="listitem" class="py-2 md:py-1">
                                                <div class="grid grid-cols-[minmax(0,1fr)_2.75rem] items-center gap-2 md:grid-cols-[minmax(0,1fr)_5.5rem_8rem_minmax(0,0.8fr)_2rem]">
                                                    <div class="min-w-0">
                                                        <label class="sr-only" for="food-@key">Alimento</label>
                                                        <input id="food-@key" class="@Ui.InputSm" placeholder="Ex.: Pão integral" @bind="item.Food" @bind:event="oninput" />
                                                    </div>
                                                    <button class="@($"{Ui.IconButtonDanger} md:order-last")" aria-label="Remover @(string.IsNullOrWhiteSpace(item.Food) ? "alimento" : item.Food)"
                                                            @onclick="() => meal.Items.Remove(item)">✕</button>
                                                    <div class="col-span-2 grid grid-cols-[5.5rem_minmax(0,1fr)] gap-2 md:col-span-3 md:grid-cols-subgrid">
                                                        <div class="min-w-0">
                                                            <label class="sr-only" for="qty-@key">Quantidade</label>
                                                            <input id="qty-@key" type="number" inputmode="decimal" min="0" step="any" placeholder="Qtd." class="@Ui.InputSm" @bind="item.Quantity" />
                                                        </div>
                                                        <div class="min-w-0">
                                                            <label class="sr-only" for="unit-@key">Unidade</label>
                                                            <input id="unit-@key" list="portion-units" placeholder="g, ml…" class="@Ui.InputSm" @bind="item.Unit" />
                                                        </div>
                                                        <div class="col-span-2 min-w-0 md:col-span-1">
                                                            <label class="sr-only" for="measure-@key">Medida caseira</label>
                                                            <input id="measure-@key" placeholder="Medida caseira (ex.: 2 fatias)" class="@Ui.InputSm" @bind="item.HouseholdMeasure" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <details class="mt-1" open="@(!string.IsNullOrWhiteSpace(item.Substitutions) || !string.IsNullOrWhiteSpace(item.Notes) ? true : null)">
                                                    <summary class="cursor-pointer py-3 text-sm text-slate-600 hover:text-slate-900 sm:py-0.5 sm:text-xs">
                                                        Substituições e observações@(string.IsNullOrWhiteSpace(item.Substitutions) && string.IsNullOrWhiteSpace(item.Notes) ? string.Empty : " ✓")
                                                    </summary>
                                                    <div class="mt-1 grid gap-2 md:grid-cols-2">
                                                        <div>
                                                            <label class="@($"{Ui.Label} text-xs")" for="subs-@key">Substituições (uma por linha)</label>
                                                            <textarea id="subs-@key" class="@Ui.InputSm" rows="2" placeholder="Ex.: Tapioca (2 colheres de sopa)" @bind="item.Substitutions"></textarea>
                                                        </div>
                                                        <div>
                                                            <label class="@($"{Ui.Label} text-xs")" for="notes-@key">Observações</label>
                                                            <textarea id="notes-@key" class="@Ui.InputSm" rows="2" @bind="item.Notes"></textarea>
                                                        </div>
                                                    </div>
                                                </details>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <button class="@($"{Ui.ButtonOutlineSm} w-full sm:w-auto")" @onclick="() => meal.Items.Add(new MealItemDraft())">+ Adicionar alimento</button>

                            <details class="mt-2 sm:mt-4">
                                <summary class="cursor-pointer py-3 text-sm text-slate-600 hover:text-slate-900 sm:py-1">Orientações da refeição@(string.IsNullOrWhiteSpace(meal.Notes) ? string.Empty : " ✓")</summary>
                                <label class="sr-only" for="meal-notes-@index">Orientações da refeição</label>
                                <textarea id="meal-notes-@index" class="@($"{Ui.InputSm} mt-2")" rows="2" @bind="meal.Notes"></textarea>
                            </details>
                        </div>
                    </section>
                }
            </fieldset>

            @if (_draft.Meals.Count > 0 && !IsEnded)
            {
                <div class="mb-6">
                    <button class="@($"{Ui.ButtonOutline} w-full sm:w-auto")" @onclick="AddMeal">+ Adicionar refeição</button>
                    <p class="@($"{Ui.Help} mt-2")">As refeições aparecem para o paciente na ordem dos horários.</p>
                </div>
            }
        </div>

        <aside class="col-span-12 min-w-0 lg:col-span-3">
            @if (_assessment is { } a && (a.ReportedAllergies is not null || a.ReportedRestrictions is not null))
            {
                <div class="@($"{Ui.AlertWarning} mb-6")">
                    <h2 class="mb-1 font-semibold">Da avaliação de @a.AssessedOn.ToString("dd/MM/yyyy")</h2>
                    @if (a.ReportedAllergies is not null)
                    {
                        <p class="break-words"><span class="font-medium">Alergias:</span> @a.ReportedAllergies</p>
                    }
                    @if (a.ReportedRestrictions is not null)
                    {
                        <p class="break-words"><span class="font-medium">Restrições:</span> @a.ReportedRestrictions</p>
                    }
                </div>
            }

            <h2 class="@($"{Ui.CardTitle} mb-2")">Versões publicadas</h2>
            @if (_plan.Versions.Count == 0)
            {
                <p class="@Ui.Help">Nenhuma ainda.</p>
            }
            else
            {
                <ol class="space-y-2 text-sm text-slate-700" reversed>
                    @foreach (var version in _plan.Versions)
                    {
                        <li>
                            <strong class="font-semibold text-slate-900">v@(version.VersionNumber)</strong> · @version.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            <div class="text-slate-500">@version.ChangeDescription</div>
                        </li>
                    }
                </ol>
            }

            @if (!IsEnded)
            {
                <hr class="@Ui.Divider" />
                @if (_ending)
                {
                    <p class="mb-3 text-sm text-slate-700">Encerrar tira o plano do aplicativo do paciente. O histórico de versões e o diário continuam guardados.</p>
                    <div class="flex flex-wrap gap-2">
                        <button class="@Ui.ButtonDangerSm" @onclick="EndAsync">Encerrar plano</button>
                        <button class="@Ui.ButtonLinkSm" @onclick="() => _ending = false">Cancelar</button>
                    </div>
                }
                else
                {
                    <button class="@Ui.ButtonDangerOutlineSm" @onclick="() => _ending = true">Encerrar plano…</button>
                }
            }
        </aside>
    </div>
}

@code {
    [Parameter]
    public Guid PlanId { get; set; }

    private DietitianMealPlan? _plan;
    private NutritionAssessmentContent? _assessment;
    private string? _clientName;
    private MealPlanDetailsForm _details = new();
    private MealPlanDraft _draft = new();
    private string _savedDetails = string.Empty;
    private string _savedDraft = string.Empty;
    private ApiProblem? _problem;
    private IReadOnlyList<string>? _issues;
    private string? _message;
    private bool _publishing;
    private bool _ending;
    private bool _busy;
    private string? _changeDescription;
    private string? _pendingNavigation;
    private bool? _detailsOpen;

    private bool IsEnded => _plan?.Status == "Ended";

    private bool IsDirty => _plan is not null && !IsEnded && (DetailsSnapshot() != _savedDetails || _draft.Snapshot() != _savedDraft);

    private string DetailsSnapshot() => System.Text.Json.JsonSerializer.Serialize(_details.ToBody(), MyHealthApiClient.Json);

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        if (!Workspace.Practices("Dietitian"))
        {
            _plan = null;
            return;
        }

        var result = await Api.GetAsync<DietitianMealPlan>($"meal-plans/{PlanId}");
        _problem = result.Problem;
        _plan = result.Value;
        if (_plan is null)
        {
            return;
        }

        _details = MealPlanDetailsForm.From(_plan.Details);
        _draft = MealPlanDraft.From(_plan.Draft);
        _savedDetails = DetailsSnapshot();
        _savedDraft = _draft.Snapshot();
        _detailsOpen ??= _plan.Draft.Meals.Count == 0;

        if (_clientName is null)
        {
            var dashboard = await Api.GetAsync<DietitianDashboard>("dietitian/dashboard");
            _clientName = dashboard.Value?.Clients.FirstOrDefault(c => c.ClientId == _plan.ClientId)?.ClientName;

            // Allergies and restrictions from the latest assessment stay in sight while the plan is written (RF-32 comes later).
            var assessments = await Api.GetAsync<List<NutritionAssessmentItem>>($"nutrition-assessments?clientId={_plan.ClientId}");
            _assessment = assessments.Value?.OrderByDescending(x => x.Content.AssessedOn).ThenByDescending(x => x.CreatedAt).FirstOrDefault()?.Content;
        }
    }

    private void AddMeal()
    {
        _draft.AddMeal();
        _message = null;
    }

    private void AddUsualDay()
    {
        _draft.AddUsualDay();
        _message = null;
    }

    private void RemoveMeal(MealDraft meal) => _draft.Meals.Remove(meal);

    private void DuplicateMeal(MealDraft meal)
    {
        var copy = _draft.Duplicate(meal);
        _message = $"{copy.Name} adicionada. Ajuste o nome e o horário.";
    }

    /// <summary>Saves the details and the meals that changed, then reloads the plan (new items get their ids, meals are sorted by time).</summary>
    private async Task<bool> SaveChangesAsync()
    {
        _message = null;
        _issues = _draft.SavingIssues();
        if (_issues.Count > 0 || string.IsNullOrWhiteSpace(_details.Name))
        {
            _issues = string.IsNullOrWhiteSpace(_details.Name) ? [.. _issues, "Dê um nome ao plano."] : _issues;
            _detailsOpen = _detailsOpen == true || string.IsNullOrWhiteSpace(_details.Name);
            return false;
        }

        _busy = true;
        try
        {
            if (DetailsSnapshot() != _savedDetails)
            {
                var details = await Api.PutAsync($"meal-plans/{PlanId}", _details.ToBody());
                _problem = details.Problem;
                if (!details.IsSuccess)
                {
                    return false;
                }
            }

            if (_draft.Snapshot() != _savedDraft)
            {
                var meals = await Api.PutAsync($"meal-plans/{PlanId}/meals", _draft.ToBody());
                _problem = meals.Problem;
                if (!meals.IsSuccess)
                {
                    return false;
                }
            }

            _problem = null;
            await LoadAsync();
            return true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (await SaveChangesAsync())
        {
            _message = "Rascunho salvo. O paciente continua vendo a versão publicada até você publicar.";
        }
    }

    private void StartPublishing()
    {
        _publishing = true;
        _message = null;
        _changeDescription ??= _plan!.CurrentVersionNumber == 0 ? "Primeira versão do plano" : null;
    }

    private async Task PublishAsync()
    {
        if (IsDirty && !await SaveChangesAsync())
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.PostAsync<PublishedVersion>($"meal-plans/{PlanId}/publish", new { changeDescription = _changeDescription!.Trim() });
            _problem = result.Problem;
            if (result.Value is { } published)
            {
                _publishing = false;
                _changeDescription = null;
                await LoadAsync();
                _message = $"Versão {published.VersionNumber} publicada. O paciente já recebe o novo plano no aplicativo.";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EndAsync()
    {
        var result = await Api.PostAsync($"meal-plans/{PlanId}/end");
        _problem = result.Problem;
        _ending = false;
        if (result.IsSuccess)
        {
            await LoadAsync();
            _message = "Plano encerrado.";
        }
    }

    private void OnBeforeNavigation(LocationChangingContext context)
    {
        if (IsDirty)
        {
            _pendingNavigation = context.TargetLocation;
            context.PreventNavigation();
        }
    }

    private async Task SaveAndLeaveAsync()
    {
        var target = _pendingNavigation!;
        _pendingNavigation = null;
        if (await SaveChangesAsync())
        {
            Navigation.NavigateTo(target);
        }
    }

    private void DiscardAndLeave()
    {
        var target = _pendingNavigation!;
        _pendingNavigation = null;
        _savedDetails = DetailsSnapshot();
        _savedDraft = _draft.Snapshot();
        Navigation.NavigateTo(target);
    }

    public void Dispose() => Workspace.Changed -= OnChanged;
}
