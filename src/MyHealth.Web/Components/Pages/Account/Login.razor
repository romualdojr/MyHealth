@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject SignInService SignIn
@inject NavigationManager Navigation

<PageTitle>Entrar · MyHealth</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h2 class="h5 mb-3">Entrar</h2>

        @if (_message is not null)
        {
            <div class="alert @(_requiresCode ? "alert-info" : "alert-danger")" role="alert">@_message</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SubmitAsync" FormName="login">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="email" class="form-label">E-mail</label>
                <InputText id="email" @bind-Value="Input.Email" class="form-control" autocomplete="username" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Senha</label>
                <InputText id="password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" />
                <ValidationMessage For="() => Input.Password" />
            </div>

            @if (_requiresCode || !string.IsNullOrEmpty(Input.Code))
            {
                <div class="mb-3">
                    <label for="code" class="form-label">Código de verificação</label>
                    <InputText id="code" @bind-Value="Input.Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
                    <div class="form-text">O código de 6 dígitos do seu aplicativo autenticador.</div>
                </div>
            }

            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </EditForm>
    </div>
</div>

<p class="text-body-secondary small text-center mt-3">
    Painel para profissionais, organizações e operadores. Clientes usam o aplicativo.
</p>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    // The form posts back to the same URL, query string included, so the return URL survives the post.
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _message;
    private bool _requiresCode;

    protected override void OnInitialized() => Input ??= new();

    private async Task SubmitAsync()
    {
        var result = await SignIn.SignInAsync(Input.Email, Input.Password, Input.Code, HttpContext.RequestAborted);
        switch (result.Outcome)
        {
            case SignInOutcome.Succeeded:
                await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal!);
                Navigation.NavigateTo(ReturnUrls.Sanitize(ReturnUrl), forceLoad: true);
                break;
            case SignInOutcome.RequiresTwoFactor:
                _requiresCode = true;
                _message = string.IsNullOrEmpty(Input.Code)
                    ? "Sua conta usa verificação em duas etapas. Informe o código do aplicativo autenticador."
                    : "Código inválido. Tente novamente.";
                break;
            case SignInOutcome.LockedOut:
                _message = "Conta bloqueada temporariamente por excesso de tentativas. Tente mais tarde.";
                break;
            default:
                _message = "E-mail ou senha incorretos.";
                break;
        }
    }


    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "E-mail inválido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha.")]
        public string Password { get; set; } = string.Empty;

        public string? Code { get; set; }
    }
}
