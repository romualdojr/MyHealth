@page "/"
@attribute [Authorize]
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api

<PageTitle>Início · MyHealth</PageTitle>

<AuthorizeView>
    <h1 class="h3">Olá, @(Workspace.Me?.FullName.Split(' ')[0] ?? context.User.Identity?.Name)</h1>
</AuthorizeView>

<ProblemAlert Problem="_problem" />

@if (_twoFactor is { IsTwoFactorEnabled: false })
{
    <div class="alert alert-warning">
        Profissionais e operadores precisam da verificação em duas etapas para acessar dados de organizações e a administração.
        <a href="account/security" class="alert-link">Ativar agora</a>.
    </div>
}

@if (Workspace.Me is null)
{
    <AuthorizeView Roles="@SessionClaims.AdministratorRole">
        <Authorized>
            <p class="text-body-secondary">Conta de operador da plataforma: a administração da plataforma fica no back office.</p>
        </Authorized>
        <NotAuthorized>
            <p class="text-body-secondary">
                Esta conta ainda não tem perfil. Conclua o cadastro no aplicativo MyHealth; profissionais criam depois o perfil profissional e
                entram (ou criam) uma organização.
            </p>
        </NotAuthorized>
    </AuthorizeView>
}
else
{
    <div class="row g-3 mt-1">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Perfis profissionais</h2>
                    @if (Workspace.Me.ProfessionalProfiles.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">Nenhum perfil profissional.</p>
                    }
                    <ul class="list-unstyled mb-0">
                        @foreach (var profile in Workspace.Me.ProfessionalProfiles)
                        {
                            <li class="d-flex justify-content-between py-1">
                                <span>@Labels.Discipline(profile.Discipline) — @profile.DisplayName</span>
                                <StatusBadge Status="@profile.VerificationStatus" />
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Organizações</h2>
                    @if (Workspace.Me.Memberships.Count == 0)
                    {
                        <p class="text-body-secondary mb-0">Você ainda não participa de nenhuma organização.</p>
                    }
                    <ul class="list-unstyled mb-0">
                        @foreach (var membership in Workspace.Me.Memberships)
                        {
                            <li class="py-1">
                                <button class="btn btn-link p-0 @(membership.TenantId == Workspace.Membership?.TenantId ? "fw-bold" : string.Empty)"
                                        @onclick="() => Workspace.SelectTenantAsync(membership.TenantId)">
                                    @membership.TenantName
                                </button>
                                <span class="text-body-secondary small">
                                    @string.Join(", ", membership.Disciplines.Select(Labels.Discipline))@(membership.IsAdministrator ? " · administrador" : string.Empty)
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private TwoFactorStatus? _twoFactor;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        // Posting an empty change returns the current two-factor status without altering it.
        var status = await Api.PostAsync<TwoFactorStatus>("auth/manage/2fa", new { });
        _twoFactor = status.Value;
        _problem = status.Problem ?? (Workspace.Problem is { Status: not 404 } p ? p : null);
    }
}
