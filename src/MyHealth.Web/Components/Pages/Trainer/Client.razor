@page "/trainer/clients/{ClientId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(_client?.ClientName ?? "Cliente") · MyHealth</PageTitle>

<nav aria-label="Caminho" class="@Ui.Breadcrumb"><a href="trainer" class="@Ui.TapLink">Clientes</a> / @(_client?.ClientName ?? "Cliente")</nav>

@if (!Workspace.Practices("PersonalTrainer"))
{
    <p class="@Ui.AlertInfo">Selecione uma organização em que você atua como personal trainer.</p>
}
else
{
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <h1 class="@($"{Ui.PageTitle} min-w-0 break-words")">@(_client?.ClientName ?? "Cliente")</h1>
        @* Phones: "Novo plano" full width on top, the other actions side by side below it. *@
        <div class="grid w-full grid-cols-2 gap-2 sm:flex sm:w-auto sm:flex-wrap">
            @if (_whatsApp is { } chat)
            {
                <a class="@($"{Ui.ButtonSuccessOutline} text-center leading-tight")" href="@chat.ChatUrl" target="_blank" rel="noopener noreferrer"
                   title="Abre uma conversa no WhatsApp. Não envie dados de saúde por lá; use o app.">Conversar no WhatsApp</a>
            }
            <a class="@($"{Ui.ButtonSecondary} text-center leading-tight {(_whatsApp is null ? "col-span-2" : string.Empty)}")" href="trainer/assistant?clientId=@ClientId">Perguntar ao assistente</a>
            <button class="@($"{Ui.Button} order-first col-span-2 sm:order-none")" @onclick="() => _creating = !_creating">Novo plano</button>
        </div>
    </div>

    <ProblemAlert Problem="_problem" />

    @if (_client is { } c)
    {
        <div class="mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
            <div><Metric Label="Treinos nos últimos 7 dias" Value="@c.CompletedLast7Days" /></div>
            <div><Metric Label="Adesão" Text="@(c.AdherenceLast7Days is { } a ? a.ToString("P0") : "—")" /></div>
            <div><Metric Label="Feedbacks sem resposta" Value="@c.PendingFeedbackReplies" /></div>
            <div><Metric Label="Relatos de desconforto" Value="@c.UnrepliedDiscomfortReports" Warn="true" /></div>
        </div>
    }

    @if (_creating)
    {
        <div class="@($"{Ui.Card} mb-6")">
            <div class="@Ui.CardBody">
                <h2 class="@($"{Ui.CardTitle} mb-1")">Novo plano</h2>
                <p class="@($"{Ui.Help} mb-4")">Comece pelo essencial; os treinos e exercícios você monta na próxima tela. Nada chega ao cliente antes de você publicar.</p>
                <PlanDetailsEditor Form="_newPlan" OnChanged="StateHasChanged" />
                <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
                    <button class="@Ui.Button" disabled="@(string.IsNullOrWhiteSpace(_newPlan.Name) || string.IsNullOrWhiteSpace(_newPlan.Goal))"
                            @onclick="CreateAsync">Criar e montar treinos</button>
                    <button class="@Ui.ButtonLink" @onclick="() => _creating = false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (_copying is { } source)
    {
        <div class="@($"{Ui.CardHighlight} mb-6")">
            <div class="@Ui.CardBody">
                <h2 class="@($"{Ui.CardTitle} mb-1 break-words")">Copiar “@source.Name” para outro cliente</h2>
                <p class="@($"{Ui.Help} mb-4")">A cópia é um rascunho novo, que você ajusta e publica para o outro cliente.</p>
                <div class="grid grid-cols-12 items-end gap-3">
                    <div class="col-span-12 md:col-span-5">
                        <label class="@Ui.Label" for="copy-target">Cliente</label>
                        <select id="copy-target" class="@Ui.Select" @bind="_copyTarget">
                            <option value="">Escolha…</option>
                            @foreach (var other in _clients.Where(o => o.ClientId != ClientId))
                            {
                                <option value="@other.ClientId">@other.ClientName</option>
                            }
                        </select>
                    </div>
                    <div class="col-span-12 md:col-span-4">
                        <label class="@Ui.Label" for="copy-name">Nome do novo plano (opcional)</label>
                        <input id="copy-name" class="@Ui.Input" @bind="_copyName" />
                    </div>
                    <div class="col-span-12 flex gap-2 md:col-span-3">
                        <button class="@($"{Ui.Button} flex-1 md:flex-none")" disabled="@(_copyTarget is null)" @onclick="CopyAsync">Copiar</button>
                        <button class="@Ui.ButtonLink" @onclick="() => _copying = null">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <h2 class="@($"{Ui.SectionTitle} mb-3")">Planos</h2>
    @if (_plans is null)
    {
        @if (_problem is null)
        {
            <Loading />
        }
    }
    else if (_plans.Count == 0)
    {
        <div class="@($"{Ui.EmptyState} mb-6")">
            <p class="mb-3">Este cliente ainda não tem plano.</p>
            <button class="@Ui.Button" @onclick="() => _creating = true">Criar o primeiro plano</button>
        </div>
    }
    else
    {
        <div class="mb-6 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white shadow-sm">
            @foreach (var plan in _plans)
            {
                <div class="flex flex-wrap items-center gap-2 px-4 py-3">
                    <div class="min-w-0 grow basis-full sm:basis-auto">
                        <div class="flex flex-wrap items-center gap-1.5">
                            <a href="trainer/plans/@plan.Id" class="inline-flex min-h-11 items-center font-semibold break-words text-teal-700 hover:text-teal-900 hover:underline sm:min-h-0">@plan.Name</a>
                            <span class="@TrainingLabels.PlanBadge(plan.Status)">@TrainingLabels.PlanStatus(plan.Status)</span>
                            @if (plan.NeedsReview)
                            {
                                <span class="@Ui.BadgeInfo">revisar</span>
                            }
                        </div>
                        <div class="mt-0.5 text-sm text-slate-500">
                            @(plan.CurrentVersionNumber > 0 ? $"Versão {plan.CurrentVersionNumber} publicada" : "Nunca publicado")
                            @(plan.HasUnpublishedChanges ? " · alterações não publicadas" : string.Empty)
                            · atualizado em @plan.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    <div class="flex w-full gap-2 sm:w-auto">
                        <a class="@($"{Ui.ButtonOutlineSm} flex-1 sm:flex-none")" href="trainer/plans/@plan.Id">Abrir</a>
                        @if (_clients.Count > 1)
                        {
                            <button class="@($"{Ui.ButtonSecondarySm} flex-1 sm:flex-none")" @onclick="() => StartCopy(plan)">Copiar para…</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="@($"{Ui.SectionTitle} mb-3")">Treinos realizados</h2>
    @if (_sessions is null)
    {
        @if (_problem is null)
        {
            <Loading />
        }
    }
    else if (_sessions.Count == 0)
    {
        <p class="@Ui.Help">Nenhum treino registrado ainda.</p>
    }
    else
    {
        @* One table for every screen size, so the open workout (and its reply field) exists only once: from md up it
           is a regular table; on phones each row turns into a card (date and status, workout, effort and feedback,
           then a full-width "Ver" button) and the open workout spans the card list. *@
        <div class="@Ui.TableWrap">
            <table class="block w-full text-sm md:table md:min-w-full">
                <thead class="@($"{Ui.THead} hidden md:table-header-group")"><tr><th class="@Ui.Th">Data</th><th class="@Ui.Th">Treino</th><th class="@Ui.Th">Situação</th><th class="@Ui.Th">Esforço</th><th class="@Ui.Th">Feedback</th><th class="@Ui.Th"><span class="sr-only">Ações</span></th></tr></thead>
                <tbody class="block divide-y divide-slate-200 md:table-row-group md:divide-slate-100">
                    @foreach (var s in _sessions)
                    {
                        <tr class="@($"grid grid-cols-2 items-center gap-x-3 gap-y-1 px-4 py-3 md:table-row md:p-0 {(s.ReportedDiscomfort && !s.HasReply ? Ui.RowWarning : string.Empty)}")">
                            <td class="@($"{WorkoutCell} row-start-2")">@((s.CompletedAt ?? s.StartedAt).ToLocalTime().ToString("dd/MM HH:mm"))</td>
                            <td class="col-span-2 row-start-1 block min-w-0 font-semibold break-words text-slate-900 md:table-cell md:px-3 md:py-2 md:align-middle md:font-normal md:text-slate-700">@s.PlannedSessionName <span class="text-xs font-normal text-slate-500">v@(s.PlanVersionNumber)</span></td>
                            <td class="@($"{WorkoutCell} row-start-2 text-right md:text-left")">@TrainingLabels.WorkoutStatus(s.Status)</td>
                            <td class="@WorkoutCell"><span class="text-slate-500 md:hidden">Esforço </span>@(s.PerceivedExertion is { } rpe ? $"{rpe}/10" : "—")</td>
                            <td class="@WorkoutCell">
                                <div class="flex flex-wrap justify-end gap-1 md:justify-start">
                                    @if (s.ReportedDiscomfort)
                                    {
                                        <span class="@Ui.BadgeDanger">desconforto</span>
                                    }
                                    @if (s.HasReply)
                                    {
                                        <span class="@Ui.BadgeSuccess">respondido</span>
                                    }
                                    else if (s.PerceivedExertion is not null)
                                    {
                                        <span class="@Ui.BadgeWarning">aguarda resposta</span>
                                    }
                                </div>
                            </td>
                            <td class="@($"{WorkoutCell} col-span-2 pt-1 md:text-right")"><button class="@($"{Ui.ButtonSecondarySm} w-full md:w-auto")" @onclick="() => ToggleAsync(s.Id)">@(_open?.Id == s.Id ? "Fechar" : "Ver")</button></td>
                        </tr>
                        @if (_open is { } detail && detail.Id == s.Id)
                        {
                            <tr class="block md:table-row">
                                <td colspan="6" class="block bg-slate-50 px-3 py-3 md:table-cell">
                                    <WorkoutDetail Session="detail" OnReplied="ReplyAsync" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_client is { } heartRateClient)
    {
        <HeartRatePanel RelationshipId="heartRateClient.RelationshipId" />
    }
}

@code {
    /// <summary>A workouts table cell: a block inside the row's card on phones, a regular cell from md up.</summary>
    private const string WorkoutCell = "block min-w-0 text-slate-700 md:table-cell md:px-3 md:py-2 md:align-middle";

    [Parameter]
    public Guid ClientId { get; set; }

    private TrainerClientSummary? _client;
    private List<TrainerClientSummary> _clients = [];
    private List<TrainerPlanItem>? _plans;
    private List<WorkoutSessionItem>? _sessions;
    private WorkoutSessionDetail? _open;
    private WhatsAppLink? _whatsApp;
    private ApiProblem? _problem;
    private bool _creating;
    private PlanDetailsForm _newPlan = new();
    private TrainerPlanItem? _copying;
    private Guid? _copyTarget;
    private string? _copyName;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _problem = null;
        _open = null;
        if (!Workspace.Practices("PersonalTrainer"))
        {
            return;
        }

        var dashboard = await Api.GetAsync<TrainerDashboard>("trainer/dashboard");
        _clients = [.. dashboard.Value?.Clients ?? []];
        _client = _clients.FirstOrDefault(c => c.ClientId == ClientId);

        // Only when the client confirmed a number and allowed professionals to contact them; otherwise no button.
        _whatsApp = _client is null ? null : (await Api.GetAsync<WhatsAppLink>($"care-relationships/{_client.RelationshipId}/whatsapp")).Value;

        var plans = await Api.GetAsync<List<TrainerPlanItem>>($"training-plans?clientId={ClientId}");
        _plans = plans.Value ?? [];

        var sessions = await Api.GetAsync<List<WorkoutSessionItem>>($"trainer/clients/{ClientId}/workout-sessions");
        _sessions = [.. (sessions.Value ?? []).OrderByDescending(s => s.StartedAt)];

        _problem = dashboard.Problem ?? plans.Problem ?? sessions.Problem;
        _creating = _creating || (_plans.Count == 0 && _problem is null);
    }

    private async Task CreateAsync()
    {
        var result = await Api.PostAsync<IdResponse>("training-plans", new { clientId = ClientId, details = _newPlan.ToBody() });
        _problem = result.Problem;
        if (result.Value is { } created)
        {
            Navigation.NavigateTo($"trainer/plans/{created.Id}");
        }
    }

    private void StartCopy(TrainerPlanItem plan)
    {
        _copying = plan;
        _copyTarget = null;
        _copyName = null;
    }

    private async Task CopyAsync()
    {
        var result = await Api.PostAsync<IdResponse>(
            $"training-plans/{_copying!.Id}/copy", new { targetClientId = _copyTarget, newName = string.IsNullOrWhiteSpace(_copyName) ? null : _copyName.Trim() });
        _problem = result.Problem;
        if (result.Value is { } created)
        {
            Navigation.NavigateTo($"trainer/plans/{created.Id}");
        }
    }

    private async Task ToggleAsync(Guid sessionId)
    {
        if (_open?.Id == sessionId)
        {
            _open = null;
            return;
        }

        var result = await Api.GetAsync<WorkoutSessionDetail>($"workout-sessions/{sessionId}");
        _open = result.Value;
        _problem = result.Problem;
    }

    private async Task ReplyAsync(string message)
    {
        var sessionId = _open!.Id;
        var result = await Api.PostAsync($"workout-sessions/{sessionId}/feedback-reply", new { message });
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            await LoadAsync();
            await ToggleAsync(sessionId);
        }
    }

    public void Dispose() => Workspace.Changed -= OnChanged;
}
