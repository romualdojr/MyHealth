@page "/trainer/plans/{PlanId:guid}"
@attribute [Authorize]
@implements IDisposable
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(_plan?.Details.Name ?? "Plano") · MyHealth</PageTitle>

<NavigationLock OnBeforeInternalNavigation="OnBeforeNavigation" ConfirmExternalNavigation="@IsDirty" />

@if (!Workspace.Practices("PersonalTrainer"))
{
    <p class="alert alert-info">Selecione uma organização em que você atua como personal trainer.</p>
}
else if (_plan is null)
{
    <ProblemAlert Problem="_problem" />
    @if (_problem is null)
    {
        <Loading />
    }
}
else
{
    <nav aria-label="Caminho" class="small mb-2">
        <a href="trainer">Clientes</a> / <a href="trainer/clients/@_plan.ClientId">@(_clientName ?? "Cliente")</a> / @_plan.Details.Name
    </nav>

    <div class="plan-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="flex-grow-1">
            <h1 class="h3 mb-0">
                @_plan.Details.Name
                <span class="badge @TrainingLabels.PlanBadge(_plan.Status) fs-6 align-middle">@TrainingLabels.PlanStatus(_plan.Status)</span>
            </h1>
            <div class="small text-body-secondary">
                @(_plan.CurrentVersionNumber > 0 ? $"O cliente vê a versão {_plan.CurrentVersionNumber}." : "O cliente ainda não vê este plano.")
                @if (IsDirty)
                {
                    <strong class="text-warning-emphasis"> Alterações não salvas.</strong>
                }
                else if (_plan.HasUnpublishedChanges)
                {
                    <span> Rascunho salvo com alterações ainda não publicadas.</span>
                }
            </div>
        </div>
        @if (!IsEnded)
        {
            <button class="btn @(IsDirty ? "btn-outline-primary" : "btn-outline-secondary")" disabled="@(!IsDirty || _busy)" @onclick="SaveAsync">Salvar rascunho</button>
            <button class="btn btn-primary" disabled="@(_busy || !(IsDirty || _plan.HasUnpublishedChanges || _plan.CurrentVersionNumber == 0))"
                    @onclick="StartPublishing">Publicar…</button>
        }
    </div>

    <ProblemAlert Problem="_problem" />

    @if (_message is not null)
    {
        <p class="alert alert-success py-2" role="status">@_message</p>
    }

    @if (_pendingNavigation is not null)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
            <span class="flex-grow-1">Há alterações não salvas neste plano.</span>
            <button class="btn btn-sm btn-primary" @onclick="SaveAndLeaveAsync">Salvar e sair</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="DiscardAndLeave">Descartar alterações</button>
            <button class="btn btn-sm btn-link" @onclick="() => _pendingNavigation = null">Continuar editando</button>
        </div>
    }

    @if (_plan.ReviewRequestedAt is not null && !IsEnded)
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
            <span class="flex-grow-1"><strong>Revisão sugerida:</strong> @(_plan.ReviewReason ?? "houve uma mudança relevante no histórico do cliente.")</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="AcknowledgeAsync">O plano continua adequado</button>
        </div>
    }

    @if (_publishing)
    {
        var issues = _draft.PublishingIssues();
        <div class="card border-primary mb-3">
            <div class="card-body">
                <h2 class="h6">Publicar versão @(_plan.CurrentVersionNumber + 1)</h2>
                @if (issues.Count > 0)
                {
                    <p class="small mb-1">Antes de publicar, ajuste:</p>
                    <ul class="small text-danger">
                        @foreach (var issue in issues)
                        {
                            <li>@issue</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small text-body-secondary">
                        O cliente passa a fazer esta versão no aplicativo e recebe um aviso. As versões anteriores ficam no histórico.
                    </p>
                }
                <label class="form-label small" for="change-description">O que mudou (o cliente vê este texto)</label>
                <input id="change-description" class="form-control mb-2" @bind="_changeDescription" @bind:event="oninput" />
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" disabled="@(issues.Count > 0 || string.IsNullOrWhiteSpace(_changeDescription) || _busy)" @onclick="PublishAsync">Publicar agora</button>
                    <button class="btn btn-link" @onclick="() => _publishing = false">Cancelar</button>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-9">
            <details class="card mb-3" open="@(_detailsOpen == true)">
                <summary class="card-header">
                    Dados do plano
                    <span class="small text-body-secondary">— @TrainingLabels.Level(_details.Level) · @_details.SuggestedSessionsPerWeek por semana · @_details.Goal</span>
                </summary>
                <div class="card-body">
                    <fieldset disabled="@IsEnded">
                        <PlanDetailsEditor Form="_details" ShowNotes="true" Prefix="details" />
                    </fieldset>
                </div>
            </details>

            @if (_draft.Sessions.Count == 0)
            {
                <div class="text-center text-body-secondary py-5 border rounded mb-3">
                    <p class="mb-3">Monte os treinos do plano. Ex.: Treino A (superiores), Treino B (inferiores), um aeróbico.</p>
                    <button class="btn btn-primary me-2" @onclick='() => AddSession("Strength")'>+ Treino de musculação</button>
                    <button class="btn btn-outline-primary" @onclick='() => AddSession("Aerobic")'>+ Treino aeróbico</button>
                </div>
            }

            <fieldset disabled="@IsEnded">
                @foreach (var session in _draft.Sessions)
                {
                    var index = _draft.Sessions.IndexOf(session);
                    <section class="card mb-3" aria-label="@session.Name">
                        <div class="card-header d-flex flex-wrap align-items-center gap-2">
                            <label class="visually-hidden" for="session-name-@index">Nome do treino</label>
                            <input id="session-name-@index" class="form-control form-control-sm fw-semibold session-name" @bind="session.Name" @bind:event="oninput" />
                            <span class="badge text-bg-light border">@TrainingLabels.SessionKind(session.Kind)</span>
                            <span class="flex-grow-1"></span>
                            <button class="btn btn-sm btn-outline-secondary" title="Mover para cima" aria-label="Mover treino para cima" disabled="@(index == 0)"
                                    @onclick="() => _draft.Sessions.Move(session, -1)">↑</button>
                            <button class="btn btn-sm btn-outline-secondary" title="Mover para baixo" aria-label="Mover treino para baixo" disabled="@(index == _draft.Sessions.Count - 1)"
                                    @onclick="() => _draft.Sessions.Move(session, 1)">↓</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => _draft.Sessions.Remove(session)">Remover treino</button>
                        </div>
                        <div class="card-body">
                            @if (session.IsAerobic)
                            {
                                var aerobic = session.Aerobic!;
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label small" for="aer-activity-@index">Atividade</label>
                                        <input id="aer-activity-@index" class="form-control" placeholder="Caminhada, bicicleta, corrida…" @bind="aerobic.Activity" @bind:event="oninput" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small" for="aer-minutes-@index">Minutos</label>
                                        <input id="aer-minutes-@index" type="number" min="1" class="form-control" @bind="aerobic.DurationMinutes" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small" for="aer-km-@index">Distância (km)</label>
                                        <input id="aer-km-@index" type="number" min="0" step="0.1" class="form-control" @bind="aerobic.DistanceKm" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small" for="aer-intensity-@index">Intensidade</label>
                                        <input id="aer-intensity-@index" class="form-control" placeholder="Ex.: moderada, consegue conversar" @bind="aerobic.Intensity" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small" for="aer-warm-@index">Aquecimento</label>
                                        <input id="aer-warm-@index" class="form-control" @bind="aerobic.WarmUp" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small" for="aer-cool-@index">Desaquecimento</label>
                                        <input id="aer-cool-@index" class="form-control" @bind="aerobic.CoolDown" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                @if (session.Exercises.Count == 0)
                                {
                                    <p class="small text-body-secondary">Nenhum exercício ainda.</p>
                                }

                                @foreach (var exercise in session.Exercises)
                                {
                                    var position = session.Exercises.IndexOf(exercise);
                                    var key = $"{index}-{position}";
                                    <div class="exercise-block border rounded p-2 mb-2">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <span class="fw-semibold flex-grow-1">@(position + 1). @exercise.ExerciseName</span>
                                            <button class="btn btn-sm btn-outline-secondary" aria-label="Mover exercício para cima" disabled="@(position == 0)"
                                                    @onclick="() => session.Exercises.Move(exercise, -1)">↑</button>
                                            <button class="btn btn-sm btn-outline-secondary" aria-label="Mover exercício para baixo" disabled="@(position == session.Exercises.Count - 1)"
                                                    @onclick="() => session.Exercises.Move(exercise, 1)">↓</button>
                                            <button class="btn btn-sm btn-outline-danger" aria-label="Remover @exercise.ExerciseName" @onclick="() => session.Exercises.Remove(exercise)">✕</button>
                                        </div>

                                        <table class="table table-sm align-middle mb-1 sets-table">
                                            <thead class="small"><tr><th>Série</th><th>Alvo</th><th>Repetições / segundos</th><th>Carga (kg)</th><th></th></tr></thead>
                                            <tbody>
                                                @foreach (var set in exercise.Sets)
                                                {
                                                    var setIndex = exercise.Sets.IndexOf(set);
                                                    var setKey = $"{key}-{setIndex}";
                                                    <tr>
                                                        <td>@(setIndex + 1)</td>
                                                        <td>
                                                            <label class="visually-hidden" for="mode-@setKey">Tipo de alvo</label>
                                                            <select id="mode-@setKey" class="form-select form-select-sm" @bind="set.ByDuration">
                                                                <option value="False">Repetições</option>
                                                                <option value="True">Tempo</option>
                                                            </select>
                                                        </td>
                                                        <td>
                                                            @if (set.ByDuration)
                                                            {
                                                                <label class="visually-hidden" for="dur-@setKey">Segundos</label>
                                                                <div class="input-group input-group-sm">
                                                                    <input id="dur-@setKey" type="number" min="1" class="form-control" @bind="set.DurationSeconds" />
                                                                    <span class="input-group-text">s</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="input-group input-group-sm">
                                                                    <label class="visually-hidden" for="min-@setKey">Mínimo de repetições</label>
                                                                    <input id="min-@setKey" type="number" min="1" class="form-control" @bind="set.MinRepetitions" />
                                                                    <span class="input-group-text">a</span>
                                                                    <label class="visually-hidden" for="max-@setKey">Máximo de repetições</label>
                                                                    <input id="max-@setKey" type="number" min="1" class="form-control" @bind="set.MaxRepetitions" />
                                                                </div>
                                                            }
                                                        </td>
                                                        <td>
                                                            <label class="visually-hidden" for="load-@setKey">Carga sugerida em kg</label>
                                                            <input id="load-@setKey" type="number" min="0" step="0.5" class="form-control form-control-sm" @bind="set.SuggestedLoadKg" />
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="btn btn-sm btn-link text-danger" aria-label="Remover série @(setIndex + 1)" @onclick="() => exercise.Sets.Remove(set)">✕</button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <button class="btn btn-sm btn-link px-0 mb-2" @onclick="exercise.AddSet">+ Adicionar série</button>

                                        <div class="row g-2">
                                            <div class="col-md-3">
                                                <label class="form-label small" for="rest-@key">Descanso entre séries</label>
                                                <div class="input-group input-group-sm">
                                                    <input id="rest-@key" type="number" min="0" max="3600" step="15" class="form-control" @bind="exercise.RestSeconds" />
                                                    <span class="input-group-text">s</span>
                                                </div>
                                            </div>
                                            <div class="col-md-9">
                                                <label class="form-label small" for="instr-@key">Instruções (opcional)</label>
                                                <input id="instr-@key" class="form-control form-control-sm" placeholder="Ex.: descer em 3 segundos, joelhos alinhados" @bind="exercise.Instructions" />
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (_pickerFor == session)
                                {
                                    <ExercisePicker Target="@session.Name" OnPick="exercise => AddExercise(session, exercise)" OnClose="() => _pickerFor = null" />
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => _pickerFor = session">+ Adicionar exercício</button>
                                }
                            }

                            <details class="mt-3">
                                <summary class="small">Observações do treino@(string.IsNullOrWhiteSpace(session.Notes) ? string.Empty : " ✓")</summary>
                                <label class="visually-hidden" for="session-notes-@index">Observações do treino</label>
                                <textarea id="session-notes-@index" class="form-control form-control-sm mt-2" rows="2" @bind="session.Notes"></textarea>
                            </details>
                        </div>
                    </section>
                }
            </fieldset>

            @if (_draft.Sessions.Count > 0 && !IsEnded)
            {
                <div class="d-flex gap-2 mb-4">
                    <button class="btn btn-outline-primary" @onclick='() => AddSession("Strength")'>+ Treino de musculação</button>
                    <button class="btn btn-outline-primary" @onclick='() => AddSession("Aerobic")'>+ Treino aeróbico</button>
                </div>
            }
        </div>

        <aside class="col-lg-3">
            <CoachPanel PlanId="PlanId" IsDirty="@IsDirty" ReadOnly="@IsEnded" OnDraftChanged="CoachChangedDraftAsync" />

            <h2 class="h6">Versões publicadas</h2>
            @if (_plan.Versions.Count == 0)
            {
                <p class="small text-body-secondary">Nenhuma ainda.</p>
            }
            else
            {
                <ol class="list-unstyled small" reversed>
                    @foreach (var version in _plan.Versions)
                    {
                        <li class="mb-2">
                            <strong>v@(version.VersionNumber)</strong> · @version.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            <div class="text-body-secondary">@version.ChangeDescription</div>
                        </li>
                    }
                </ol>
            }

            @if (!IsEnded)
            {
                <hr />
                @if (_ending)
                {
                    <p class="small">Encerrar tira o plano do aplicativo do cliente. O histórico de versões e treinos continua guardado.</p>
                    <button class="btn btn-sm btn-danger me-2" @onclick="EndAsync">Encerrar plano</button>
                    <button class="btn btn-sm btn-link" @onclick="() => _ending = false">Cancelar</button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _ending = true">Encerrar plano…</button>
                }
            }
        </aside>
    </div>
}

@code {
    [Parameter]
    public Guid PlanId { get; set; }

    private TrainerPlan? _plan;
    private string? _clientName;
    private PlanDetailsForm _details = new();
    private PlanDraft _draft = new();
    private string _savedDetails = string.Empty;
    private string _savedDraft = string.Empty;
    private ApiProblem? _problem;
    private string? _message;
    private SessionDraft? _pickerFor;
    private bool _publishing;
    private bool _ending;
    private bool _busy;
    private string? _changeDescription;
    private string? _pendingNavigation;
    private bool? _detailsOpen;

    private bool IsEnded => _plan?.Status == "Ended";

    private bool IsDirty => _plan is not null && !IsEnded && (DetailsSnapshot() != _savedDetails || _draft.Snapshot() != _savedDraft);

    private string DetailsSnapshot() => System.Text.Json.JsonSerializer.Serialize(_details.ToBody(), MyHealthApiClient.Json);

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        if (!Workspace.Practices("PersonalTrainer"))
        {
            _plan = null;
            return;
        }

        var result = await Api.GetAsync<TrainerPlan>($"training-plans/{PlanId}");
        _problem = result.Problem;
        _plan = result.Value;
        if (_plan is null)
        {
            return;
        }

        _details = PlanDetailsForm.From(_plan.Details);
        _draft = PlanDraft.From(_plan.Draft);
        _savedDetails = DetailsSnapshot();
        _savedDraft = _draft.Snapshot();
        _pickerFor = null;
        _detailsOpen ??= _plan.Draft.Sessions.Count == 0;

        if (_clientName is null)
        {
            var dashboard = await Api.GetAsync<TrainerDashboard>("trainer/dashboard");
            _clientName = dashboard.Value?.Clients.FirstOrDefault(c => c.ClientId == _plan.ClientId)?.ClientName;
        }
    }

    private void AddSession(string kind)
    {
        var session = _draft.AddSession(kind);
        _pickerFor = session.IsAerobic ? null : session;
        _message = null;
    }

    private void AddExercise(SessionDraft session, ExerciseItem exercise)
    {
        session.Exercises.Add(ExerciseDraft.New(exercise));
        _message = $"{exercise.Name} adicionado a {session.Name}.";
    }

    /// <summary>Saves the details and the sessions that changed, then reloads the plan (new items get their ids).</summary>
    private async Task<bool> SaveChangesAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            if (DetailsSnapshot() != _savedDetails)
            {
                var details = await Api.PutAsync($"training-plans/{PlanId}", _details.ToBody());
                _problem = details.Problem;
                if (!details.IsSuccess)
                {
                    return false;
                }
            }

            if (_draft.Snapshot() != _savedDraft)
            {
                var sessions = await Api.PutAsync($"training-plans/{PlanId}/sessions", _draft.ToBody());
                _problem = sessions.Problem;
                if (!sessions.IsSuccess)
                {
                    return false;
                }
            }

            _problem = null;
            await LoadAsync();
            return true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (await SaveChangesAsync())
        {
            _message = "Rascunho salvo. O cliente continua vendo a versão publicada até você publicar.";
        }
    }

    private void StartPublishing()
    {
        _publishing = true;
        _message = null;
        _changeDescription ??= _plan!.CurrentVersionNumber == 0 ? "Primeira versão do plano" : null;
    }

    private async Task PublishAsync()
    {
        if (IsDirty && !await SaveChangesAsync())
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await Api.PostAsync<PublishedVersion>($"training-plans/{PlanId}/publish", new { changeDescription = _changeDescription!.Trim() });
            _problem = result.Problem;
            if (result.Value is { } published)
            {
                _publishing = false;
                _changeDescription = null;
                await LoadAsync();
                _message = $"Versão {published.VersionNumber} publicada. O cliente já recebe o novo plano no aplicativo.";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CoachChangedDraftAsync()
    {
        await LoadAsync();
        _message = "Sugestão aplicada ao rascunho. Revise e publique quando estiver pronto.";
    }

    private async Task AcknowledgeAsync()
    {
        var result = await Api.PostAsync($"training-plans/{PlanId}/acknowledge-review");
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            await LoadAsync();
        }
    }

    private async Task EndAsync()
    {
        var result = await Api.PostAsync($"training-plans/{PlanId}/end");
        _problem = result.Problem;
        _ending = false;
        if (result.IsSuccess)
        {
            await LoadAsync();
            _message = "Plano encerrado.";
        }
    }

    private void OnBeforeNavigation(LocationChangingContext context)
    {
        if (IsDirty)
        {
            _pendingNavigation = context.TargetLocation;
            context.PreventNavigation();
        }
    }

    private async Task SaveAndLeaveAsync()
    {
        var target = _pendingNavigation!;
        _pendingNavigation = null;
        if (await SaveChangesAsync())
        {
            Navigation.NavigateTo(target);
        }
    }

    private void DiscardAndLeave()
    {
        var target = _pendingNavigation!;
        _pendingNavigation = null;
        _savedDetails = DetailsSnapshot();
        _savedDraft = _draft.Snapshot();
        Navigation.NavigateTo(target);
    }

    public void Dispose() => Workspace.Changed -= OnChanged;
}
