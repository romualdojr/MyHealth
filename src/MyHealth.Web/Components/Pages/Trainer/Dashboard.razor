@page "/trainer"
@attribute [Authorize]
@implements IDisposable
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api

<PageTitle>Clientes · MyHealth</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <h1 class="h3 mb-0">Clientes</h1>
    @if (Workspace.Practices("PersonalTrainer"))
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="trainer/exercises">Biblioteca de exercícios</a>
            <button class="btn btn-primary" @onclick="() => _inviting = !_inviting">Convidar cliente</button>
        </div>
    }
</div>

@if (!Workspace.Practices("PersonalTrainer"))
{
    <p class="alert alert-info">Selecione uma organização em que você atua como personal trainer.</p>
}
else
{
    <p class="text-body-secondary">
        Abra um cliente para montar e publicar o plano de treino dele. Adesão dos últimos 7 dias em relação à frequência sugerida,
        feedbacks sem resposta, relatos de desconforto e planos que pedem revisão.
    </p>

    <ProblemAlert Problem="_problem" />

    @if (_inviting)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h2 class="h6">Convidar cliente</h2>
                <p class="small text-body-secondary mb-2">
                    O cliente recebe o convite no aplicativo ao entrar com este e-mail e decide o que compartilhar com você.
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small" for="client-email">E-mail do cliente</label>
                        <input id="client-email" type="email" class="form-control" @bind="_inviteEmail" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-primary w-100" disabled="@string.IsNullOrWhiteSpace(_inviteEmail)" @onclick="InviteAsync">Enviar convite</button>
                    </div>
                </div>
                @if (_invited is not null)
                {
                    <p class="small text-success mt-2 mb-0" role="status">Convite enviado para @_invited.</p>
                }
            </div>
        </div>
    }

    @if (_dashboard is null)
    {
        @if (_problem is null)
        {
            <Loading />
        }
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-4"><Metric Label="Feedbacks sem resposta" Value="@_dashboard.TotalPendingFeedback" /></div>
            <div class="col-sm-4"><Metric Label="Relatos de desconforto" Value="@_dashboard.TotalDiscomfortReports" Warn="true" /></div>
            <div class="col-sm-4"><Metric Label="Planos para revisar" Value="@_dashboard.TotalPlansNeedingReview" Warn="true" /></div>
        </div>

        @if (_dashboard.Clients.Count == 0)
        {
            <div class="text-center text-body-secondary py-5 border rounded">
                <p class="mb-2">Nenhum cliente com vínculo ativo ainda.</p>
                <button class="btn btn-primary" @onclick="() => _inviting = true">Convidar o primeiro cliente</button>
            </div>
        }
        else
        {
            <table class="table align-middle">
                <thead>
                    <tr><th>Cliente</th><th>Plano ativo</th><th>Últimos 7 dias</th><th>Adesão</th><th>Pendências</th><th>Último treino</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _dashboard.Clients)
                    {
                        <tr class="@(c.UnrepliedDiscomfortReports > 0 ? "table-warning" : string.Empty)">
                            <td><a href="trainer/clients/@c.ClientId" class="fw-semibold">@c.ClientName</a></td>
                            <td>
                                @if (c.ActivePlanName is { } plan)
                                {
                                    @plan
                                }
                                else
                                {
                                    <a href="trainer/clients/@c.ClientId" class="small">Criar plano</a>
                                }
                            </td>
                            <td>@c.CompletedLast7Days@(c.SuggestedSessionsPerWeek is { } s ? $" de {s}" : string.Empty)</td>
                            <td>@(c.AdherenceLast7Days is { } a ? a.ToString("P0") : "—")</td>
                            <td class="small">
                                @if (c.UnrepliedDiscomfortReports > 0)
                                {
                                    <span class="badge text-bg-danger me-1">@c.UnrepliedDiscomfortReports desconforto</span>
                                }
                                @if (c.PendingFeedbackReplies > 0)
                                {
                                    <span class="badge text-bg-warning me-1">@c.PendingFeedbackReplies feedback</span>
                                }
                                @if (c.PlansNeedingReview > 0)
                                {
                                    <span class="badge text-bg-info">revisar plano</span>
                                }
                            </td>
                            <td>@(c.LastCompletedAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    private TrainerDashboard? _dashboard;
    private ApiProblem? _problem;
    private bool _inviting;
    private string? _inviteEmail;
    private string? _invited;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _dashboard = null;
        _problem = null;
        if (!Workspace.Practices("PersonalTrainer"))
        {
            return;
        }

        var result = await Api.GetAsync<TrainerDashboard>("trainer/dashboard");
        _dashboard = result.Value;
        _problem = result.Problem;
    }

    private async Task InviteAsync()
    {
        var email = _inviteEmail!.Trim();
        var result = await Api.PostAsync<IdResponse>("care-relationships/invitations", new { discipline = "PersonalTrainer", clientEmail = email });
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            _invited = email;
            _inviteEmail = null;
        }
    }

    public void Dispose() => Workspace.Changed -= OnChanged;
}
