@page "/trainer"
@attribute [Authorize]
@implements IDisposable
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api

<PageTitle>Clientes · MyHealth</PageTitle>

<div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <h1 class="@Ui.PageTitle">Clientes</h1>
    @if (Workspace.Practices("PersonalTrainer"))
    {
        <div class="flex flex-wrap gap-2">
            @* On phones the library is a tab of the bottom bar. *@
            <div class="hidden sm:block">
                <a class="@Ui.ButtonSecondary" href="trainer/exercises">Biblioteca de exercícios</a>
            </div>
            <button class="@Ui.Button" aria-expanded="@(_inviting ? "true" : "false")" @onclick="() => _inviting = !_inviting">Convidar cliente</button>
        </div>
    }
</div>

@if (!Workspace.Practices("PersonalTrainer"))
{
    <p class="@Ui.AlertInfo">Selecione uma organização em que você atua como personal trainer.</p>
}
else
{
    <p class="@($"{Ui.Help} mb-4")">
        Abra um cliente para montar e publicar o plano de treino dele. Adesão dos últimos 7 dias em relação à frequência sugerida,
        feedbacks sem resposta, relatos de desconforto e planos que pedem revisão.
    </p>

    <ProblemAlert Problem="_problem" />

    @if (_dashboard is not null)
    {
        <OpenPlansOfFormerClients Plans="_plans" ActiveClientIds="@(_dashboard.Clients.Select(c => c.ClientId).ToList())" Resource="training-plans" />
    }

    @if (_inviting)
    {
        <div class="@($"{Ui.Card} mb-6")">
            <div class="@Ui.CardBody">
                <h2 class="@($"{Ui.CardTitle} mb-1")">Convidar cliente</h2>
                <p class="@($"{Ui.Help} mb-3")">
                    O cliente recebe o convite no aplicativo ao entrar com este e-mail e decide o que compartilhar com você.
                </p>
                <div class="grid grid-cols-12 items-end gap-3">
                    <div class="col-span-12 md:col-span-6">
                        <label class="@Ui.Label" for="client-email">E-mail do cliente</label>
                        <input id="client-email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false"
                               class="@Ui.Input" @bind="_inviteEmail" @bind:event="oninput" />
                    </div>
                    <div class="col-span-12 md:col-span-3">
                        <button class="@($"{Ui.Button} w-full")" disabled="@string.IsNullOrWhiteSpace(_inviteEmail)" @onclick="InviteAsync">Enviar convite</button>
                    </div>
                </div>
                @if (_invited is not null)
                {
                    <p class="mt-2 text-sm text-emerald-700" role="status">Convite enviado para @_invited.</p>
                }
            </div>
        </div>
    }

    @if (_dashboard is null)
    {
        @if (_problem is null)
        {
            <Loading />
        }
    }
    else
    {
        <div class="mb-6 grid grid-cols-3 gap-2 sm:gap-4">
            <div><Metric Label="Feedbacks sem resposta" Value="@_dashboard.TotalPendingFeedback" /></div>
            <div><Metric Label="Relatos de desconforto" Value="@_dashboard.TotalDiscomfortReports" Warn="true" /></div>
            <div><Metric Label="Planos para revisar" Value="@_dashboard.TotalPlansNeedingReview" Warn="true" /></div>
        </div>

        @if (_dashboard.Clients.Count == 0)
        {
            <div class="@Ui.EmptyState">
                <p class="mb-3">Nenhum cliente com vínculo ativo ainda.</p>
                <button class="@Ui.Button" @onclick="() => _inviting = true">Convidar o primeiro cliente</button>
            </div>
        }
        else
        {
            @* One table for every screen size, so each client keeps a single link (and a single text match): from md up a
               regular table; on phones each row is a card tapped as a whole (the name link stretches over it) showing name,
               plan, adherence and pending items. *@
            <div class="md:overflow-x-auto md:rounded-xl md:border md:border-slate-200 md:bg-white md:shadow-sm">
                <table class="w-full text-sm max-md:block md:min-w-full">
                    <thead class="bg-slate-50 max-md:hidden">
                        <tr><th class="@Ui.Th">Cliente</th><th class="@Ui.Th">Plano ativo</th><th class="@Ui.Th">Últimos 7 dias</th><th class="@Ui.Th">Adesão</th><th class="@Ui.Th">Pendências</th><th class="@Ui.Th">Último treino</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 max-md:block max-md:divide-slate-200 max-md:overflow-hidden max-md:rounded-xl max-md:border max-md:border-slate-200 max-md:bg-white max-md:shadow-sm">
                        @foreach (var c in _dashboard.Clients)
                        {
                            <tr class="@($"relative max-md:grid max-md:min-h-14 max-md:grid-cols-[minmax(0,1fr)_auto] max-md:items-center max-md:gap-x-3 max-md:gap-y-1 max-md:px-4 max-md:py-3 max-md:active:bg-slate-100 {(c.UnrepliedDiscomfortReports > 0 ? Ui.RowWarning : string.Empty)}")">
                                <td class="@($"{Cell} col-start-1 row-start-1 min-w-0 max-md:block")">
                                    <a href="trainer/clients/@c.ClientId" class="@($"{Ui.Link} font-semibold max-md:block max-md:truncate max-md:text-base max-md:after:absolute max-md:after:inset-0")">@c.ClientName</a>
                                </td>
                                <td class="@($"{Cell} col-start-1 row-start-2 min-w-0 max-md:block max-md:truncate max-md:text-slate-500")">
                                    @if (c.ActivePlanName is { } plan)
                                    {
                                        @plan
                                    }
                                    else
                                    {
                                        <a href="trainer/clients/@c.ClientId" class="@($"{Ui.Link} text-sm")">Criar plano</a>
                                    }
                                </td>
                                <td class="@($"{Cell} max-md:hidden")">@c.CompletedLast7Days@(c.SuggestedSessionsPerWeek is { } s ? $" de {s}" : string.Empty)</td>
                                <td class="@($"{Cell} col-start-2 row-span-2 row-start-1 max-md:block max-md:text-right")">
                                    <span class="max-md:block max-md:text-base max-md:font-semibold max-md:text-slate-900">@(c.AdherenceLast7Days is { } a ? a.ToString("P0") : "—")</span>
                                    <span class="block text-xs text-slate-500 md:hidden">adesão 7 dias</span>
                                </td>
                                <td class="@($"{Cell} col-span-2 row-start-3 {(HasPending(c) ? "max-md:block" : "max-md:hidden")}")">
                                    <div class="flex flex-wrap gap-1">
                                        @if (c.UnrepliedDiscomfortReports > 0)
                                        {
                                            <span class="@Ui.BadgeDanger">@c.UnrepliedDiscomfortReports desconforto</span>
                                        }
                                        @if (c.PendingFeedbackReplies > 0)
                                        {
                                            <span class="@Ui.BadgeWarning">@c.PendingFeedbackReplies feedback</span>
                                        }
                                        @if (c.PlansNeedingReview > 0)
                                        {
                                            <span class="@Ui.BadgeInfo">revisar plano</span>
                                        }
                                    </div>
                                </td>
                                <td class="@($"{Cell} max-md:hidden")">@(c.LastCompletedAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    private TrainerDashboard? _dashboard;
    private List<OpenPlansOfFormerClients.OpenPlan> _plans = [];
    private ApiProblem? _problem;
    private bool _inviting;
    private string? _inviteEmail;
    private string? _invited;

    /// <summary>A table cell from md up; on phones a piece of the client's card (each cell adds max-md:block or max-md:hidden).</summary>
    private const string Cell = "align-middle text-slate-700 md:px-3 md:py-2";

    private static bool HasPending(TrainerClientSummary c) =>
        c.UnrepliedDiscomfortReports > 0 || c.PendingFeedbackReplies > 0 || c.PlansNeedingReview > 0;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _dashboard = null;
        _problem = null;
        if (!Workspace.Practices("PersonalTrainer"))
        {
            return;
        }

        var result = await Api.GetAsync<TrainerDashboard>("trainer/dashboard");
        _dashboard = result.Value;
        _problem = result.Problem;

        // Plans of clients who ended the relationship (listed apart so they can be ended).
        var plans = await Api.GetAsync<List<TrainerPlanItem>>("training-plans");
        _plans = [.. (plans.Value ?? []).Select(p => new OpenPlansOfFormerClients.OpenPlan(p.Id, p.ClientId, p.Name, p.Status, p.UpdatedAt))];
    }

    private async Task InviteAsync()
    {
        var email = _inviteEmail!.Trim();
        var result = await Api.PostAsync<IdResponse>("care-relationships/invitations", new { discipline = "PersonalTrainer", clientEmail = email });
        _problem = result.Problem;
        if (result.IsSuccess)
        {
            _invited = email;
            _inviteEmail = null;
        }
    }

    public void Dispose() => Workspace.Changed -= OnChanged;
}
