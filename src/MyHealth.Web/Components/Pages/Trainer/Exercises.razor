@page "/trainer/exercises"
@attribute [Authorize]
@implements IDisposable
@inject WorkspaceState Workspace
@inject MyHealthApiClient Api

<PageTitle>Biblioteca de exercícios · MyHealth</PageTitle>

<nav aria-label="Caminho" class="@Ui.Breadcrumb"><a href="trainer" class="@Ui.TapLink">Clientes</a> / Biblioteca de exercícios</nav>

<div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <h1 class="@Ui.PageTitle">Biblioteca de exercícios</h1>
    @if (Workspace.Practices("PersonalTrainer"))
    {
        <button class="@Ui.Button" @onclick="StartNew">Novo exercício</button>
    }
</div>

@if (!Workspace.Practices("PersonalTrainer"))
{
    <p class="@Ui.AlertInfo">Selecione uma organização em que você atua como personal trainer.</p>
}
else
{
    <p class="@($"{Ui.Help} mb-4")">
        A biblioteca do MyHealth mais os exercícios criados pela sua organização. Os exercícios da organização só aparecem para quem atua nela.
    </p>

    <ProblemAlert Problem="_problem" />

    @if (_editing is not null)
    {
        @* A bottom sheet on phones (opened from anywhere in the list), an inline card from sm up. *@
        <div class="@Ui.SheetBackdrop" aria-hidden="true" @onclick="() => _editing = null"></div>
        <div class="@($"{Ui.Sheet} sm:mb-6")">
            <div>
                <div class="mb-3 flex items-center justify-between gap-2">
                    <h2 class="@Ui.CardTitle">@(_editingId is null ? "Novo exercício da organização" : $"Editar {_editing.Name}")</h2>
                    <button class="@($"{Ui.CloseButton} sm:hidden")" aria-label="Fechar" @onclick="() => _editing = null">✕</button>
                </div>
                <div class="grid grid-cols-12 gap-3">
                    <div class="col-span-12 md:col-span-6">
                        <label class="@Ui.Label" for="ex-name">Nome</label>
                        <input id="ex-name" autocomplete="off" autocapitalize="sentences" class="@Ui.Input" @bind="_editing.Name" @bind:event="oninput" />
                    </div>
                    <div class="col-span-12 md:col-span-6">
                        <label class="@Ui.Label" for="ex-purpose">Finalidade (opcional)</label>
                        <input id="ex-purpose" autocomplete="off" class="@Ui.Input" placeholder="Ex.: força, mobilidade" @bind="_editing.Purpose" />
                    </div>
                    <div class="col-span-12">
                        <label class="@Ui.Label" for="ex-description">Como executar</label>
                        <textarea id="ex-description" class="@Ui.Textarea" rows="3" @bind="_editing.Description" @bind:event="oninput"></textarea>
                    </div>
                    <div class="col-span-12 md:col-span-6">
                        <label class="@Ui.Label" for="ex-muscles">Grupos musculares (separados por vírgula)</label>
                        <input id="ex-muscles" autocomplete="off" autocapitalize="off" class="@Ui.Input" placeholder="quadríceps, glúteos" @bind="_editing.MuscleGroups" />
                    </div>
                    <div class="col-span-12 md:col-span-6">
                        <label class="@Ui.Label" for="ex-equipment">Equipamentos (separados por vírgula)</label>
                        <input id="ex-equipment" autocomplete="off" autocapitalize="off" class="@Ui.Input" placeholder="halter, banco" @bind="_editing.Equipment" />
                    </div>
                    <div class="col-span-12">
                        <label class="@Ui.Label" for="ex-precautions">Cuidados (opcional)</label>
                        <textarea id="ex-precautions" class="@Ui.Textarea" rows="2" @bind="_editing.Precautions"></textarea>
                    </div>
                    <div class="col-span-12">
                        <label class="@Ui.Label" for="ex-caption">Descrição do vídeo, para acessibilidade (necessária antes de adicionar vídeo)</label>
                        <textarea id="ex-caption" class="@Ui.Textarea" rows="2" @bind="_editing.MediaCaption"></textarea>
                    </div>
                </div>
                <div class="mt-4 flex flex-wrap gap-2">
                    <button class="@($"{Ui.Button} flex-1 sm:flex-none")" disabled="@(string.IsNullOrWhiteSpace(_editing.Name) || string.IsNullOrWhiteSpace(_editing.Description))"
                            @onclick="SaveAsync">Salvar</button>
                    <button class="@Ui.ButtonLink" @onclick="() => _editing = null">Cancelar</button>
                </div>
            </div>
        </div>
    }

    @if (_motionFor is { } target)
    {
        <MotionCapturePanel @key="target.Id" ExerciseId="target.Id" ExerciseName="@target.Name" OnClose="() => _motionFor = null" OnAccepted="() => LoadAsync()" />
    }

    <div class="mb-4 grid grid-cols-12 gap-3">
        <div class="col-span-12 md:col-span-6">
            <label class="sr-only" for="library-search">Buscar</label>
            <input id="library-search" type="search" enterkeyhint="search" autocomplete="off" class="@Ui.Input" placeholder="Buscar por nome ou descrição" @bind="_search" @bind:event="oninput" @bind:after="SearchSoonAsync" />
        </div>
    </div>

    @if (_results is null)
    {
        <Loading />
    }
    else
    {
        <div class="@($"{Ui.TableWrap} mb-4 hidden md:block")">
            <table class="@Ui.Table">
                <thead class="@Ui.THead"><tr><th class="@Ui.Th">Exercício</th><th class="@Ui.Th">Músculos</th><th class="@Ui.Th">Equipamento</th><th class="@Ui.Th">Mídia</th><th class="@Ui.Th"></th></tr></thead>
                <tbody class="@Ui.TBody">
                    @foreach (var e in _results.Items)
                    {
                        <tr>
                            <td class="@Ui.Td">
                                <span class="font-semibold text-slate-900">@e.Name</span>
                                @if (e.IsCustom)
                                {
                                    <span class="@($"{Ui.BadgeNeutral} ml-1")">da organização</span>
                                }
                                <div class="max-w-lg truncate text-xs text-slate-500">@e.Description</div>
                            </td>
                            <td class="@($"{Ui.Td} text-sm")">@string.Join(", ", e.MuscleGroups)</td>
                            <td class="@($"{Ui.Td} text-sm")">@string.Join(", ", e.Equipment)</td>
                            <td class="@($"{Ui.Td} text-sm")">@(e.Media.Count == 0 ? "—" : $"{e.Media.Count} item(ns)")@if (e.Media.Any(m => m.Kind == "Model3D"))
                                {
                                    <span class="@($"{Ui.BadgePrimary} ml-1")">3D</span>
                                }</td>
                            <td class="@($"{Ui.Td} text-right")">
                                @if (e.IsCustom)
                                {
                                    <div class="flex justify-end gap-1">
                                        <button class="@Ui.ButtonSecondarySm" @onclick="() => StartEdit(e)">Editar</button>
                                        <button class="@Ui.ButtonOutlineSm" @onclick="() => { _motionFor = e; _editing = null; }">Vídeo 3D</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phones: one card per exercise, with its actions. *@
        @if (_results.Items.Count == 0)
        {
            <p class="@($"{Ui.EmptyState} mb-4 md:hidden")">Nenhum exercício encontrado.</p>
        }
        else
        {
            <ul class="@($"{Ui.List} mb-4 md:hidden")">
                @foreach (var e in _results.Items)
                {
                    <li class="@Ui.ListItem">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <span class="font-semibold text-slate-900">@e.Name</span>
                            @if (e.IsCustom)
                            {
                                <span class="@Ui.BadgeNeutral">da organização</span>
                            }
                            @if (e.Media.Any(m => m.Kind == "Model3D"))
                            {
                                <span class="@Ui.BadgePrimary">3D</span>
                            }
                        </div>
                        <p class="mt-1 line-clamp-2 text-sm text-slate-500">@e.Description</p>
                        @if (e.MuscleGroups.Count > 0 || e.Equipment.Count > 0)
                        {
                            <p class="mt-1 text-sm text-slate-700">
                                @string.Join(", ", e.MuscleGroups)@(e.MuscleGroups.Count > 0 && e.Equipment.Count > 0 ? " · " : string.Empty)<span class="text-slate-500">@string.Join(", ", e.Equipment)</span>
                            </p>
                        }
                        @if (e.Media.Count > 0)
                        {
                            <p class="mt-1 text-xs text-slate-500">Mídia: @e.Media.Count item(ns)</p>
                        }
                        @if (e.IsCustom)
                        {
                            <div class="mt-3 grid grid-cols-2 gap-2">
                                <button class="@Ui.ButtonSecondarySm" @onclick="() => StartEdit(e)">Editar</button>
                                <button class="@Ui.ButtonOutlineSm" @onclick="() => { _motionFor = e; _editing = null; }">Vídeo 3D</button>
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        <div class="flex flex-wrap items-center justify-between gap-2 sm:justify-start">
            <button class="@Ui.ButtonSecondarySm" disabled="@(_page <= 1)" @onclick="() => GoToAsync(_page - 1)">Anterior</button>
            <span class="text-sm text-slate-500">Página @_page de @Math.Max(1, (int)Math.Ceiling(_results.TotalCount / (double)PageSize)) · @_results.TotalCount exercícios</span>
            <button class="@Ui.ButtonSecondarySm" disabled="@(_page * PageSize >= _results.TotalCount)" @onclick="() => GoToAsync(_page + 1)">Próxima</button>
        </div>
    }
}

@code {
    private const int PageSize = 50;

    private sealed class ExerciseForm
    {
        public string Name { get; set; } = string.Empty;

        public string Description { get; set; } = string.Empty;

        public string? MuscleGroups { get; set; }

        public string? Equipment { get; set; }

        public string? Purpose { get; set; }

        public string? Precautions { get; set; }

        public string? MediaCaption { get; set; }

        public object ToBody() => new
        {
            name = Name.Trim(),
            description = Description.Trim(),
            muscleGroups = Split(MuscleGroups),
            equipment = Split(Equipment),
            purpose = Blank(Purpose),
            precautions = Blank(Precautions),
            mediaCaption = Blank(MediaCaption),
        };

        private static string[] Split(string? value) =>
            [.. (value ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(v => v.ToLowerInvariant()).Distinct()];

        private static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private PagedResponse<ExerciseItem>? _results;
    private ApiProblem? _problem;
    private string? _search;
    private int _page = 1;
    private ExerciseForm? _editing;
    private Guid? _editingId;
    private ExerciseItem? _motionFor;
    private CancellationTokenSource? _typing;

    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += OnChanged;
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync(CancellationToken ct = default)
    {
        if (!Workspace.Practices("PersonalTrainer"))
        {
            return;
        }

        var result = await Api.GetAsync<PagedResponse<ExerciseItem>>(
            $"exercises?page={_page}&pageSize={PageSize}&search={Uri.EscapeDataString(_search ?? string.Empty)}", ct);
        ct.ThrowIfCancellationRequested();
        _results = result.Value ?? new PagedResponse<ExerciseItem>([], _page, PageSize, 0);
        _problem = result.Problem;
    }

    private async Task SearchSoonAsync()
    {
        _typing?.Cancel();
        _typing?.Dispose();
        _typing = new CancellationTokenSource();
        var ct = _typing.Token;
        try
        {
            await Task.Delay(250, ct);
            _page = 1;
            await LoadAsync(ct);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke started another search.
        }
    }

    private async Task GoToAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void StartNew()
    {
        _motionFor = null;
        _editingId = null;
        _editing = new ExerciseForm();
    }

    private void StartEdit(ExerciseItem exercise)
    {
        _motionFor = null;
        _editingId = exercise.Id;
        _editing = new ExerciseForm
        {
            Name = exercise.Name,
            Description = exercise.Description,
            MuscleGroups = string.Join(", ", exercise.MuscleGroups),
            Equipment = string.Join(", ", exercise.Equipment),
            Purpose = exercise.Purpose,
            Precautions = exercise.Precautions,
            MediaCaption = exercise.MediaCaption,
        };
    }

    private async Task SaveAsync()
    {
        var problem = _editingId is { } id
            ? (await Api.PutAsync($"exercises/{id}", _editing!.ToBody())).Problem
            : (await Api.PostAsync<IdResponse>("exercises", _editing!.ToBody())).Problem;
        _problem = problem;
        if (problem is null)
        {
            _search = _editing.Name;
            _editing = null;
            _page = 1;
            await LoadAsync();
        }
    }

    public void Dispose()
    {
        Workspace.Changed -= OnChanged;
        _typing?.Cancel();
        _typing?.Dispose();
    }
}
