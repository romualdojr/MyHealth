@* The meal plan's name, goal, dates and notes; used when creating a plan and in the meal plan editor. *@

<div class="grid grid-cols-12 gap-3">
    <div class="col-span-12 md:col-span-6">
        <label class="@Ui.Label" for="@($"{Prefix}-name")">Nome do plano</label>
        <input id="@($"{Prefix}-name")" class="@Ui.Input" placeholder="Ex.: Reeducação alimentar — fase 1" @bind="Form.Name" @bind:event="oninput" @bind:after="Changed" />
    </div>
    <div class="col-span-6 min-w-0 md:col-span-3">
        <label class="@Ui.Label" for="@($"{Prefix}-start")">Início</label>
        <input id="@($"{Prefix}-start")" type="date" class="@($"{Ui.Input} min-w-0")" @bind="Form.StartDate" @bind:after="Changed" />
    </div>
    <div class="col-span-6 min-w-0 md:col-span-3">
        <label class="@Ui.Label" for="@($"{Prefix}-end")">Fim (opcional)</label>
        <input id="@($"{Prefix}-end")" type="date" class="@($"{Ui.Input} min-w-0")" @bind="Form.EndDate" @bind:after="Changed" />
    </div>
    <div class="col-span-12">
        <label class="@Ui.Label" for="@($"{Prefix}-goal")">Objetivo (opcional)</label>
        <input id="@($"{Prefix}-goal")" class="@Ui.Input" placeholder="Ex.: mais energia durante o dia, regularizar os horários" @bind="Form.Goal" @bind:event="oninput" @bind:after="Changed" />
    </div>
    @if (ShowNotes)
    {
        <div class="col-span-12">
            <label class="@Ui.Label" for="@($"{Prefix}-notes")">Orientações gerais para o paciente (opcional)</label>
            <textarea id="@($"{Prefix}-notes")" class="@Ui.Textarea" rows="3" placeholder="Ex.: beba 2 litros de água por dia" @bind="Form.Notes" @bind:event="oninput" @bind:after="Changed"></textarea>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public MealPlanDetailsForm Form { get; set; } = default!;

    [Parameter]
    public bool ShowNotes { get; set; }

    [Parameter]
    public string Prefix { get; set; } = "meal-plan";

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task Changed() => OnChanged.InvokeAsync();
}
