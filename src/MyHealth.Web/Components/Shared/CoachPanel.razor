@* The trainer's AI coach for one plan: request an analysis, then apply suggestions to the draft or dismiss them. *@
@inject MyHealthApiClient Api

<section class="@($"{Ui.Card} mb-4")" aria-labelledby="coach-title">
    <div class="@Ui.CardBody">
        <h2 id="coach-title" class="@($"{Ui.CardTitle} mb-1")">Assistente de treino (IA)</h2>
        <p class="@($"{Ui.Help} mb-3")">
            Compara o que o cliente fez com o que foi prescrito e sugere ajustes. A decisão é sua: nada muda até você aplicar e publicar.
        </p>

        <ProblemAlert Problem="_problem" />

        @if (_overview is null)
        {
            @if (_problem is null)
            {
                <Loading />
            }
        }
        else if (!_overview.SharingGranted)
        {
            <p class="@Ui.AlertNeutral">
                O cliente ainda não autorizou a análise por IA dos treinos dele. Ele pode ativar em <strong>Compartilhamento › Análise por IA</strong> no aplicativo.
            </p>
        }
        else
        {
            @if (!ReadOnly)
            {
                <label class="@Ui.Label" for="coach-focus">Algo específico? (opcional)</label>
                <input id="coach-focus" class="@($"{Ui.InputSm} mb-2")" placeholder="Ex.: estagnação no supino" maxlength="500" @bind="_focus" />
                <button class="@($"{Ui.ButtonSm} w-full")" disabled="@(_busy || _overview.UsedToday >= _overview.DailyLimit)" @onclick="AnalyzeAsync">
                    @(_busy ? "Analisando…" : "Analisar progresso")
                </button>
                <p class="mt-1 mb-3 text-xs text-slate-500">@_overview.UsedToday de @_overview.DailyLimit análises nas últimas 24 h na organização.</p>
            }

            @if (_overview.Analyses.Count > 0)
            {
                var latest = _overview.Analyses[0];
                <div class="border-t border-slate-200 pt-3" aria-live="polite">
                    <div class="mb-1 text-xs text-slate-500">
                        @latest.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") · versão @latest.PlanVersionNumber@(latest.Focus is { } f ? $" · foco: {f}" : string.Empty)
                    </div>
                    <p class="mb-3 text-sm text-slate-700">@latest.Summary</p>
                    @foreach (var notice in latest.Notices)
                    {
                        <p class="mb-2 rounded-md border border-amber-200 bg-amber-50 px-2 py-1 text-sm text-amber-900">@notice</p>
                    }

                    @if (IsDirty && latest.Suggestions.Any(s => s.Status == "Pending"))
                    {
                        <p class="mb-2 text-sm text-amber-700">Salve o rascunho antes de aplicar sugestões.</p>
                    }

                    @foreach (var suggestion in latest.Suggestions)
                    {
                        <div class="mb-2 rounded-lg border border-slate-200 p-3 text-sm text-slate-700 @(suggestion.Status == "Pending" ? string.Empty : "opacity-75")">
                            <div class="font-semibold text-slate-900">@suggestion.Title</div>
                            @if (suggestion.Change is { } change)
                            {
                                <div>@change</div>
                            }
                            <div class="text-slate-500">@suggestion.Reason</div>
                            @if (suggestion.Status == "Pending")
                            {
                                @if (!ReadOnly)
                                {
                                    <div class="mt-2 flex gap-2">
                                        <button class="@Ui.ButtonOutlineSm" disabled="@(_busy || IsDirty)" @onclick="() => ResolveAsync(latest, suggestion, apply: true)">
                                            @(suggestion.Kind == "TalkToClient" ? "Feito" : "Aplicar ao rascunho")
                                        </button>
                                        <button class="@Ui.ButtonLinkSm" disabled="@_busy" @onclick="() => ResolveAsync(latest, suggestion, apply: false)">Dispensar</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="@($"{(suggestion.Status == "Applied" ? Ui.BadgeSuccess : Ui.BadgeNeutral)} mt-1")">
                                    @(suggestion.Status == "Applied" ? "aplicada" : "dispensada")
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (_overview.Analyses.Count > 1)
                {
                    <details class="mt-2 text-sm text-slate-700">
                        <summary class="cursor-pointer py-1 font-medium text-slate-600 hover:text-slate-900">Análises anteriores</summary>
                        @foreach (var older in _overview.Analyses.Skip(1))
                        {
                            <div class="mt-2">
                                <div class="text-slate-500">@older.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") · @older.Suggestions.Count(s => s.Status == "Applied") aplicada(s)</div>
                                @older.Summary
                            </div>
                        }
                    </details>
                }
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Guid PlanId { get; set; }

    /// <summary>The editor has unsaved changes: applying would act on the saved draft, so it waits for a save.</summary>
    [Parameter]
    public bool IsDirty { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>A suggestion changed the saved draft; the editor reloads it.</summary>
    [Parameter]
    public EventCallback OnDraftChanged { get; set; }

    private CoachOverview? _overview;
    private ApiProblem? _problem;
    private string? _focus;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<CoachOverview>($"training-plans/{PlanId}/coach");
        _overview = result.Value;
        _problem = result.Problem;
    }

    private async Task AnalyzeAsync()
    {
        _busy = true;
        try
        {
            var result = await Api.PostAsync<CoachAnalysisItem>($"training-plans/{PlanId}/coach/analyses", new { focus = string.IsNullOrWhiteSpace(_focus) ? null : _focus.Trim() });
            _problem = result.Problem;
            if (result.IsSuccess)
            {
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResolveAsync(CoachAnalysisItem analysis, CoachSuggestionItem suggestion, bool apply)
    {
        _busy = true;
        try
        {
            var result = await Api.PostAsync<CoachAnalysisItem>(
                $"coach-analyses/{analysis.Id}/suggestions/{suggestion.Id}/{(apply ? "apply" : "dismiss")}", null);
            _problem = result.Problem;
            if (result.IsSuccess)
            {
                await LoadAsync();
                if (apply && suggestion.Kind != "TalkToClient")
                {
                    await OnDraftChanged.InvokeAsync();
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
