@* The trainer's AI coach for one plan: request an analysis, then apply suggestions to the draft or dismiss them. *@
@inject MyHealthApiClient Api

<section class="card mb-3 coach-panel" aria-labelledby="coach-title">
    <div class="card-body">
        <h2 id="coach-title" class="h6 mb-1">Assistente de treino (IA)</h2>
        <p class="small text-body-secondary mb-2">
            Compara o que o cliente fez com o que foi prescrito e sugere ajustes. A decisão é sua: nada muda até você aplicar e publicar.
        </p>

        <ProblemAlert Problem="_problem" />

        @if (_overview is null)
        {
            @if (_problem is null)
            {
                <Loading />
            }
        }
        else if (!_overview.SharingGranted)
        {
            <p class="small alert alert-secondary mb-0">
                O cliente ainda não autorizou a análise por IA dos treinos dele. Ele pode ativar em <strong>Compartilhamento › Análise por IA</strong> no aplicativo.
            </p>
        }
        else
        {
            @if (!ReadOnly)
            {
                <label class="form-label small" for="coach-focus">Algo específico? (opcional)</label>
                <input id="coach-focus" class="form-control form-control-sm mb-2" placeholder="Ex.: estagnação no supino" maxlength="500" @bind="_focus" />
                <button class="btn btn-sm btn-primary w-100" disabled="@(_busy || _overview.UsedToday >= _overview.DailyLimit)" @onclick="AnalyzeAsync">
                    @(_busy ? "Analisando…" : "Analisar progresso")
                </button>
                <p class="small text-body-secondary mt-1 mb-2">@_overview.UsedToday de @_overview.DailyLimit análises nas últimas 24 h na organização.</p>
            }

            @if (_overview.Analyses.Count > 0)
            {
                var latest = _overview.Analyses[0];
                <div class="border-top pt-2" aria-live="polite">
                    <div class="small text-body-secondary mb-1">
                        @latest.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") · versão @latest.PlanVersionNumber@(latest.Focus is { } f ? $" · foco: {f}" : string.Empty)
                    </div>
                    <p class="small">@latest.Summary</p>
                    @foreach (var notice in latest.Notices)
                    {
                        <p class="small alert alert-warning py-1 px-2">@notice</p>
                    }

                    @if (IsDirty && latest.Suggestions.Any(s => s.Status == "Pending"))
                    {
                        <p class="small text-warning-emphasis">Salve o rascunho antes de aplicar sugestões.</p>
                    }

                    @foreach (var suggestion in latest.Suggestions)
                    {
                        <div class="border rounded p-2 mb-2 small @(suggestion.Status == "Pending" ? string.Empty : "opacity-75")">
                            <div class="fw-semibold">@suggestion.Title</div>
                            @if (suggestion.Change is { } change)
                            {
                                <div>@change</div>
                            }
                            <div class="text-body-secondary">@suggestion.Reason</div>
                            @if (suggestion.Status == "Pending")
                            {
                                @if (!ReadOnly)
                                {
                                    <div class="d-flex gap-2 mt-1">
                                        <button class="btn btn-sm btn-outline-primary" disabled="@(_busy || IsDirty)" @onclick="() => ResolveAsync(latest, suggestion, apply: true)">
                                            @(suggestion.Kind == "TalkToClient" ? "Feito" : "Aplicar ao rascunho")
                                        </button>
                                        <button class="btn btn-sm btn-link" disabled="@_busy" @onclick="() => ResolveAsync(latest, suggestion, apply: false)">Dispensar</button>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge @(suggestion.Status == "Applied" ? "text-bg-success" : "text-bg-secondary") mt-1">
                                    @(suggestion.Status == "Applied" ? "aplicada" : "dispensada")
                                </span>
                            }
                        </div>
                    }
                </div>

                @if (_overview.Analyses.Count > 1)
                {
                    <details class="small">
                        <summary>Análises anteriores</summary>
                        @foreach (var older in _overview.Analyses.Skip(1))
                        {
                            <div class="mt-2">
                                <div class="text-body-secondary">@older.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm") · @older.Suggestions.Count(s => s.Status == "Applied") aplicada(s)</div>
                                @older.Summary
                            </div>
                        }
                    </details>
                }
            }
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public Guid PlanId { get; set; }

    /// <summary>The editor has unsaved changes: applying would act on the saved draft, so it waits for a save.</summary>
    [Parameter]
    public bool IsDirty { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>A suggestion changed the saved draft; the editor reloads it.</summary>
    [Parameter]
    public EventCallback OnDraftChanged { get; set; }

    private CoachOverview? _overview;
    private ApiProblem? _problem;
    private string? _focus;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<CoachOverview>($"training-plans/{PlanId}/coach");
        _overview = result.Value;
        _problem = result.Problem;
    }

    private async Task AnalyzeAsync()
    {
        _busy = true;
        try
        {
            var result = await Api.PostAsync<CoachAnalysisItem>($"training-plans/{PlanId}/coach/analyses", new { focus = string.IsNullOrWhiteSpace(_focus) ? null : _focus.Trim() });
            _problem = result.Problem;
            if (result.IsSuccess)
            {
                await LoadAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResolveAsync(CoachAnalysisItem analysis, CoachSuggestionItem suggestion, bool apply)
    {
        _busy = true;
        try
        {
            var result = await Api.PostAsync<CoachAnalysisItem>(
                $"coach-analyses/{analysis.Id}/suggestions/{suggestion.Id}/{(apply ? "apply" : "dismiss")}", null);
            _problem = result.Problem;
            if (result.IsSuccess)
            {
                await LoadAsync();
                if (apply && suggestion.Kind != "TalkToClient")
                {
                    await OnDraftChanged.InvokeAsync();
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
