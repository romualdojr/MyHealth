@* Warns everyone in the selected organization when it is behind on payments; administrators get a link to pay. *@
@implements IDisposable
@inject WorkspaceState Workspace

@switch (Workspace.Membership?.SubscriptionStatus)
{
    case "PastDue":
        <div class="alert alert-warning py-2">
            A organização tem uma fatura vencida com a MyHealth; sem pagamento, ela será suspensa.
            @PayLink
        </div>
        break;
    case "Suspended":
        <div class="alert alert-danger py-2">
            A organização está suspensa: os atendimentos por ela estão bloqueados até a regularização.
            @PayLink
        </div>
        break;
    case "Cancelled":
        <div class="alert alert-danger py-2">A assinatura desta organização foi cancelada.</div>
        break;
}

@code {
    private RenderFragment PayLink => @<text>
        @if (Workspace.IsTenantAdministrator)
        {
            <a href="organization/billing" class="alert-link">Ver faturas</a>
        }
        else
        {
            <span>Fale com o administrador da organização.</span>
        }
    </text>;

    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
