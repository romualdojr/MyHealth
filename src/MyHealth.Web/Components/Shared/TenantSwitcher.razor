@* Selects the organization the user acts for (MT-02). The API honours it only for an active membership. *@
@implements IDisposable
@inject WorkspaceState Workspace

@if (Workspace.Me is { Memberships.Count: > 0 } me)
{
    <label class="m-0 flex flex-col items-stretch gap-1 text-sm lg:flex-row lg:items-center lg:gap-2">
        <span class="text-xs font-medium text-slate-500">Organização</span>
        <select class="@($"{Ui.SelectSm} w-full lg:w-auto lg:max-w-[14rem]")" value="@(Workspace.Membership?.TenantId.ToString() ?? string.Empty)" @onchange="OnSelected">
            <option value="">Visão de cliente</option>
            @foreach (var membership in me.Memberships)
            {
                <option value="@membership.TenantId">@membership.TenantName</option>
            }
        </select>
    </label>
}

@code {
    protected override void OnInitialized() => Workspace.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private Task OnSelected(ChangeEventArgs e) =>
        Workspace.SelectTenantAsync(Guid.TryParse(e.Value?.ToString(), out var id) ? id : null);

    public void Dispose() => Workspace.Changed -= OnChanged;
}
