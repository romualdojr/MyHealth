@* An inline confirmation with a free-text justification, used for actions that are audited with a reason. *@

<div class="card border-@Tone mb-3">
    <div class="card-body">
        <h2 class="h6">@Title</h2>
        @if (Description is not null)
        {
            <p class="small text-body-secondary">@Description</p>
        }
        <label class="form-label small" for="reason-text">@Label</label>
        <textarea id="reason-text" class="form-control mb-2" rows="2" @bind="_text" @bind:event="oninput"></textarea>
        <div class="d-flex gap-2">
            <button class="btn btn-@Tone btn-sm" disabled="@(Required && string.IsNullOrWhiteSpace(_text))" @onclick="() => OnConfirm.InvokeAsync(_text)">@ConfirmText</button>
            <button class="btn btn-link btn-sm" @onclick="OnCancel">Cancelar</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Label { get; set; } = "Motivo";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirmar";

    [Parameter]
    public bool Required { get; set; } = true;

    /// <summary>Bootstrap colour of the confirmation (primary, danger…).</summary>
    [Parameter]
    public string Tone { get; set; } = "primary";

    [Parameter]
    public EventCallback<string?> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string? _text;
}
