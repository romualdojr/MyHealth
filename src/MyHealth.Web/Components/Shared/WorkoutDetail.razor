@* A performed workout as the trainer reviews it: logged sets, the client's feedback, body checks and the reply. *@

<div class="space-y-4 sm:p-2">
    @if (Session.Sets.Count == 0)
    {
        <p class="@Ui.Help">Nenhuma série registrada.</p>
    }
    else
    {
        <div class="@($"{Ui.TableWrap} hidden md:block")">
            <table class="@Ui.Table">
                <thead class="@Ui.THead"><tr><th class="@Ui.Th">Série</th><th class="@Ui.Th">Repetições</th><th class="@Ui.Th">Carga</th><th class="@Ui.Th">Duração</th><th class="@Ui.Th">Dificuldade</th><th class="@Ui.Th">Nota</th></tr></thead>
                <tbody class="@Ui.TBody">
                    @foreach (var set in Session.Sets.OrderBy(s => s.SetNumber))
                    {
                        <tr>
                            <td class="@Ui.Td">@set.SetNumber</td>
                            <td class="@Ui.Td">@(set.Repetitions?.ToString() ?? "—")</td>
                            <td class="@Ui.Td">@(set.LoadKg is { } kg ? $"{kg:0.#} kg" : "—")</td>
                            <td class="@Ui.Td">@(set.DurationSeconds is { } d ? $"{d}s" : "—")</td>
                            <td class="@Ui.Td">@(set.Difficulty?.ToString() ?? "—")</td>
                            <td class="@Ui.Td">@set.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Phones: one line per set instead of the table. *@
        <ul class="@($"{Ui.List} md:hidden")" aria-label="Séries registradas">
            @foreach (var set in Session.Sets.OrderBy(s => s.SetNumber))
            {
                <li class="@($"{Ui.ListItem} text-sm text-slate-700")">
                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-0.5">
                        <span class="font-semibold text-slate-900">Série @set.SetNumber</span>
                        @if (set.Repetitions is { } reps)
                        {
                            <span>@reps rep.</span>
                        }
                        @if (set.LoadKg is { } kg)
                        {
                            <span>@($"{kg:0.#} kg")</span>
                        }
                        @if (set.DurationSeconds is { } d)
                        {
                            <span>@($"{d}s")</span>
                        }
                        @if (set.Difficulty is { } difficulty)
                        {
                            <span class="text-slate-500">dificuldade @difficulty</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(set.Notes))
                    {
                        <div class="mt-0.5 break-words text-slate-500">@set.Notes</div>
                    }
                </li>
            }
        </ul>
    }

    @if (Session.BodyChecks.Count > 0)
    {
        <div>
            <h3 class="@($"{Ui.CardTitle} mb-2")">Como o corpo respondeu</h3>
            <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700">
                @foreach (var check in Session.BodyChecks)
                {
                    <li><strong>@check.Subject</strong>: @TrainingLabels.BodyCheckAnswer(check.Answer)@(check.Details is { } d ? $" — {d}" : string.Empty)</li>
                }
            </ul>
        </div>
    }

    @if (Session.Feedback is { } feedback)
    {
        <div>
            <h3 class="@($"{Ui.CardTitle} mb-2")">Feedback do cliente</h3>
            <p class="mb-1 text-sm text-slate-700">Esforço percebido: <strong>@feedback.PerceivedExertion/10</strong></p>
            @if (feedback.ReportedDiscomfort)
            {
                <p class="mb-1 text-sm text-red-700">Relatou desconforto@(feedback.DiscomfortDetails is { } d ? $": {d}" : ".")</p>
            }
            @if (feedback.Comments is { } comments)
            {
                <p class="mb-3 text-sm text-slate-700">“@comments”</p>
            }

            @if (Session.Reply is { } reply)
            {
                <div class="border-l-4 border-emerald-500 pl-3 text-sm text-slate-700">
                    <div class="text-slate-500">Sua resposta em @reply.RepliedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                    @reply.Message
                </div>
            }
            else
            {
                <label class="@Ui.Label" for="reply-@Session.Id">Responder ao cliente</label>
                <textarea id="reply-@Session.Id" class="@($"{Ui.Textarea} mb-2")" rows="2" @bind="_reply" @bind:event="oninput"></textarea>
                <button class="@($"{Ui.ButtonSm} w-full sm:w-auto")" disabled="@string.IsNullOrWhiteSpace(_reply)" @onclick="ReplyAsync">Enviar resposta</button>
            }
        </div>
    }
    else
    {
        <p class="@Ui.Help">O cliente ainda não enviou feedback deste treino.</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public WorkoutSessionDetail Session { get; set; } = default!;

    [Parameter]
    public EventCallback<string> OnReplied { get; set; }

    private string? _reply;

    private async Task ReplyAsync()
    {
        await OnReplied.InvokeAsync(_reply!.Trim());
        _reply = null;
    }
}
